{
  "tool": "stars",
  "modules": {
    "StarsScore": "score.js",
    "StarsSky": "sky.js"
  },
  "global": "StarsScore",
  "cases": [
    {
      "name": "光害: 指標の下限は完全な暗さ",
      "func": "darknessFromIndex",
      "args": [
        10
      ],
      "expect": 1
    },
    {
      "name": "光害: 下限より小さい値も1で頭打ち",
      "func": "darknessFromIndex",
      "args": [
        0
      ],
      "expect": 1
    },
    {
      "name": "光害: 都心(255)の暗さは0",
      "func": "darknessFromIndex",
      "args": [
        255
      ],
      "expect": 0
    },
    {
      "name": "光害: 255を超える値も0で頭打ち",
      "func": "darknessFromIndex",
      "args": [
        300
      ],
      "expect": 0
    },
    {
      "name": "光害: 乗鞍畳平クラス(110)は0.8",
      "func": "darknessFromIndex",
      "args": [
        110
      ],
      "expect": 0.8
    },
    {
      "name": "光害: 奥多摩クラス(150)は0.45",
      "func": "darknessFromIndex",
      "args": [
        150
      ],
      "expect": 0.45
    },
    {
      "name": "光害: アンカーの中間は直線補間(40と70の中点)",
      "func": "darknessFromIndex",
      "args": [
        55
      ],
      "expect": 0.915
    },
    {
      "name": "スコア: 雲量が無いときは点を付けない(快晴に化けさせない)",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "precipPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": null
    },
    {
      "name": "スコア: 雲量が null なら点を付けない",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": null,
          "precipPct": 0
        }
      ],
      "expect": null
    },
    {
      "name": "スコア: 雲量が文字列なら点を付けない",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": "0",
          "precipPct": 0
        }
      ],
      "expect": null
    },
    {
      "name": "スコア: 降水確率が欠けても雲量があれば出せる(影響なしとして扱う)",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "score": 85.8
      }
    },
    {
      "name": "スコア: 暗所・快晴・新月は最高ランク",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "score": 85.8,
        "darkness": 0.81,
        "band": {
          "key": "excellent"
        }
      }
    },
    {
      "name": "スコア: 曇天は暗所でも0",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 100,
          "precipPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "score": 0,
        "band": {
          "key": "none"
        }
      }
    },
    {
      "name": "スコア: 雲量50は大きく減点される",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 50,
          "precipPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "score": 37.3,
        "band": {
          "key": "poor"
        }
      }
    },
    {
      "name": "スコア: 満月が天頂だと暗所でも大きく落ちる",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 1
        }
      ],
      "expect": {
        "score": 34.3,
        "band": {
          "key": "bad"
        }
      }
    },
    {
      "name": "スコア: 都心は快晴・新月でも悪い",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 254,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "score": 25.2,
        "band": {
          "key": "bad"
        }
      }
    },
    {
      "name": "スコア: 都市の外れ(奥多摩)は快晴・新月でまずまず",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 150,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "score": 58.8,
        "band": {
          "key": "fair"
        }
      }
    },
    {
      "name": "スコア: 視程・湿度が良好なら減点しない",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0,
          "visibilityM": 24000,
          "humidityPct": 50
        }
      ],
      "expect": {
        "score": 85.8,
        "hasAirQuality": true
      }
    },
    {
      "name": "スコア: 靄(視程5km・湿度95%)は半分近くまで落ちる",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0,
          "visibilityM": 5000,
          "humidityPct": 95
        }
      ],
      "expect": {
        "score": 42.4,
        "band": {
          "key": "poor"
        },
        "hasAirQuality": true
      }
    },
    {
      "name": "スコア: 視程・湿度が無いときは減点せずフラグで区別する",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "hasAirQuality": false
      }
    },
    {
      "name": "スコア: 降水確率が高い夜はほぼ不可",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 60,
          "precipPct": 80,
          "moonBrightness": 0
        }
      ],
      "expect": {
        "score": 14.8,
        "band": {
          "key": "none"
        }
      }
    },
    {
      "name": "段階: 80はちょうど最高",
      "func": "bandOf",
      "args": [
        80
      ],
      "expect": {
        "key": "excellent"
      }
    },
    {
      "name": "段階: 79.9は良い",
      "func": "bandOf",
      "args": [
        79.9
      ],
      "expect": {
        "key": "good"
      }
    },
    {
      "name": "段階: 0は不可",
      "func": "bandOf",
      "args": [
        0
      ],
      "expect": {
        "key": "none"
      }
    },
    {
      "name": "段階: 添字は最良が0",
      "func": "bandIndex",
      "args": [
        100
      ],
      "expect": 0
    },
    {
      "name": "段階: 添字は最悪が5",
      "func": "bandIndex",
      "args": [
        0
      ],
      "expect": 5
    },
    {
      "name": "表示項目: 総合は3要素すべてを含む",
      "func": "layerOf",
      "args": [
        "total"
      ],
      "expect": {
        "key": "total",
        "parts": {
          "sky": true,
          "weather": true,
          "moon": true
        }
      }
    },
    {
      "name": "表示項目: 空の暗さは光害だけ",
      "func": "layerOf",
      "args": [
        "sky"
      ],
      "expect": {
        "parts": {
          "sky": true,
          "weather": false,
          "moon": false
        }
      }
    },
    {
      "name": "表示項目: 天気は光害と月を含まない",
      "func": "layerOf",
      "args": [
        "weather"
      ],
      "expect": {
        "parts": {
          "sky": false,
          "weather": true,
          "moon": false
        }
      }
    },
    {
      "name": "表示項目: 知らない名前は総合に落とす",
      "func": "layerOf",
      "args": [
        "なにか"
      ],
      "expect": {
        "key": "total"
      }
    },
    {
      "name": "月: 新月の夜(2026-08-12 東京)は輝面比0・影響なし",
      "global": "StarsSky",
      "func": "summary",
      "args": [
        "2026-08-12T21:00:00+09:00",
        35.68,
        139.76
      ],
      "expect": {
        "illuminationPct": 0,
        "brightness": 0,
        "phaseLabel": "新月"
      }
    },
    {
      "name": "月: 満月の夜(2026-07-29 東京)は輝面比100・高度27.2度(JPL Horizons)",
      "note": "期待値の出所: JPL Horizons, 東経139.76/北緯35.68/標高0, 2026-07-29 13:00 UTC, airless apparent topocentric elevation = 27.202735度, 輝面比 99.93%。brightness は 0.9993×sin(27.2027度)。",
      "global": "StarsSky",
      "func": "summary",
      "args": [
        "2026-07-29T22:00:00+09:00",
        35.68,
        139.76
      ],
      "expect": {
        "illuminationPct": 100,
        "altitudeDeg": 27.2,
        "brightness": 0.457,
        "phaseLabel": "満月"
      }
    },
    {
      "name": "月: 満月でも地平線下なら影響ゼロ",
      "note": "期待値の出所: JPL Horizons, 同地点, 2026-07-29 01:00 UTC, elevation = -68.092359度, 輝面比 99.61%。",
      "global": "StarsSky",
      "func": "summary",
      "args": [
        "2026-07-29T10:00:00+09:00",
        35.68,
        139.76
      ],
      "expect": {
        "illuminationPct": 100,
        "altitudeDeg": -68.1,
        "brightness": 0
      }
    },
    {
      "name": "月: 上弦(2026-08-20頃)は輝面比がおよそ半分",
      "global": "StarsSky",
      "func": "summary",
      "args": [
        "2026-08-20T21:00:00+09:00",
        35.68,
        139.76
      ],
      "expect": {
        "phaseLabel": "上弦"
      }
    },
    {
      "name": "月の出入り: 新月の夜(2026-08-12 東京)は一晩中沈んでいる",
      "global": "StarsSky",
      "func": "moonRiseSetSummary",
      "args": [
        "2026-08-12T11:10:00Z",
        "2026-08-12T18:20:00Z",
        35.68,
        139.76
      ],
      "expect": {
        "rise": null,
        "set": null,
        "upAtStart": false
      }
    },
    {
      "name": "月の出入り: 満月の夜(2026-07-29 東京)は日没時にはもう出ている",
      "global": "StarsSky",
      "func": "moonRiseSetSummary",
      "args": [
        "2026-07-29T11:00:00Z",
        "2026-07-29T19:00:00Z",
        35.68,
        139.76
      ],
      "expect": {
        "upAtStart": true
      }
    },
    {
      "name": "夜: 東京の夏至前後は夜が短い(7.2時間)",
      "global": "StarsSky",
      "func": "nightWindowSummary",
      "args": [
        "2026-08-12",
        35.68,
        139.76
      ],
      "expect": {
        "start": "2026-08-12T11:10Z",
        "end": "2026-08-12T18:20Z",
        "hours": 7.2
      }
    },
    {
      "name": "夜: 東京の冬至は夜が長い(11時間)",
      "global": "StarsSky",
      "func": "nightWindowSummary",
      "args": [
        "2026-12-21",
        35.68,
        139.76
      ],
      "expect": {
        "hours": 11
      }
    },
    {
      "name": "夜: 夏の稚内は東京より夜が短い",
      "global": "StarsSky",
      "func": "nightWindowSummary",
      "args": [
        "2026-08-12",
        45.42,
        141.67
      ],
      "expect": {
        "hours": 5.5
      }
    },
    {
      "name": "夜: 夏の石垣島は東京より夜が長い",
      "global": "StarsSky",
      "func": "nightWindowSummary",
      "args": [
        "2026-08-12",
        24.34,
        124.16
      ],
      "expect": {
        "hours": 8.2
      }
    },
    {
      "name": "夜: 白夜(6月のトロムソ)は暗くならないので null",
      "global": "StarsSky",
      "func": "nightWindowSummary",
      "args": [
        "2026-06-21",
        69.65,
        18.96
      ],
      "expect": null
    },
    {
      "name": "太陽: 東京の正午は高度が正",
      "global": "StarsSky",
      "func": "sunAltitudeDeg",
      "args": [
        "2026-08-12T12:00:00+09:00",
        35.68,
        139.76
      ],
      "expect": 69.23
    },
    {
      "name": "太陽: 東京の深夜は地平線下",
      "global": "StarsSky",
      "func": "sunAltitudeDeg",
      "args": [
        "2026-08-13T00:00:00+09:00",
        35.68,
        139.76
      ],
      "expect": -39.24
    },
    {
      "name": "今夜の判定: 前夜が明けたあと(8/13 11:34 JST)は当日の夜",
      "global": "StarsSky",
      "func": "currentNightDate",
      "args": [
        35.68,
        139.76,
        "2026-08-13T02:34:00Z"
      ],
      "expect": "2026-08-13"
    },
    {
      "name": "今夜の判定: 前夜が継続中(8/13 02:00 JST)は前日の夜",
      "global": "StarsSky",
      "func": "currentNightDate",
      "args": [
        35.68,
        139.76,
        "2026-08-12T17:00:00Z"
      ],
      "expect": "2026-08-12"
    },
    {
      "name": "今夜の判定: 夜が進行中(8/12 22:00 JST)は当日の夜",
      "global": "StarsSky",
      "func": "currentNightDate",
      "args": [
        35.68,
        139.76,
        "2026-08-12T13:00:00Z"
      ],
      "expect": "2026-08-12"
    },
    {
      "name": "今夜の判定: 日没前(8/13 18:00 JST)は当日の夜",
      "global": "StarsSky",
      "func": "currentNightDate",
      "args": [
        35.68,
        139.76,
        "2026-08-13T09:00:00Z"
      ],
      "expect": "2026-08-13"
    },
    {
      "name": "今夜の判定: 天文薄明が始まった後(8/13 04:30 JST)は当日の夜",
      "global": "StarsSky",
      "func": "currentNightDate",
      "args": [
        35.68,
        139.76,
        "2026-08-12T19:30:00Z"
      ],
      "expect": "2026-08-13"
    }
  ]
}
