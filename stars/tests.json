{
  "tool": "stars",
  "modules": {
    "StarsScore": "score.js",
    "StarsMoon": "moon.js"
  },
  "global": "StarsScore",
  "cases": [
    {
      "name": "光害: 指標の下限は完全な暗さ",
      "func": "darknessFromIndex",
      "args": [10],
      "expect": 1
    },
    {
      "name": "光害: 下限より小さい値も1で頭打ち",
      "func": "darknessFromIndex",
      "args": [0],
      "expect": 1
    },
    {
      "name": "光害: 都心(255)の暗さは0",
      "func": "darknessFromIndex",
      "args": [255],
      "expect": 0
    },
    {
      "name": "光害: 255を超える値も0で頭打ち",
      "func": "darknessFromIndex",
      "args": [300],
      "expect": 0
    },
    {
      "name": "光害: 乗鞍畳平クラス(110)は0.8",
      "func": "darknessFromIndex",
      "args": [110],
      "expect": 0.8
    },
    {
      "name": "光害: 奥多摩クラス(150)は0.45",
      "func": "darknessFromIndex",
      "args": [150],
      "expect": 0.45
    },
    {
      "name": "光害: アンカーの中間は直線補間(40と70の中点)",
      "func": "darknessFromIndex",
      "args": [55],
      "expect": 0.915
    },

    {
      "name": "スコア: 暗所・快晴・新月は最高ランク",
      "func": "evaluate",
      "args": [{ "lpIndex": 105, "cloudPct": 0, "precipPct": 0, "moonBrightness": 0 }],
      "expect": { "score": 85.8, "darkness": 0.81, "band": { "key": "excellent" } }
    },
    {
      "name": "スコア: 曇天は暗所でも0",
      "func": "evaluate",
      "args": [{ "lpIndex": 105, "cloudPct": 100, "precipPct": 0, "moonBrightness": 0 }],
      "expect": { "score": 0, "band": { "key": "none" } }
    },
    {
      "name": "スコア: 雲量50は大きく減点される",
      "func": "evaluate",
      "args": [{ "lpIndex": 105, "cloudPct": 50, "precipPct": 0, "moonBrightness": 0 }],
      "expect": { "score": 37.3, "band": { "key": "poor" } }
    },
    {
      "name": "スコア: 満月が天頂だと暗所でも大きく落ちる",
      "func": "evaluate",
      "args": [{ "lpIndex": 105, "cloudPct": 0, "precipPct": 0, "moonBrightness": 1 }],
      "expect": { "score": 34.3, "band": { "key": "bad" } }
    },
    {
      "name": "スコア: 都心は快晴・新月でも悪い",
      "func": "evaluate",
      "args": [{ "lpIndex": 254, "cloudPct": 0, "precipPct": 0, "moonBrightness": 0 }],
      "expect": { "score": 25.2, "band": { "key": "bad" } }
    },
    {
      "name": "スコア: 都市の外れ(奥多摩)は快晴・新月でまずまず",
      "func": "evaluate",
      "args": [{ "lpIndex": 150, "cloudPct": 0, "precipPct": 0, "moonBrightness": 0 }],
      "expect": { "score": 58.8, "band": { "key": "fair" } }
    },
    {
      "name": "スコア: 視程・湿度が良好なら減点しない",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0,
          "visibilityM": 24000,
          "humidityPct": 50
        }
      ],
      "expect": { "score": 85.8, "hasAirQuality": true }
    },
    {
      "name": "スコア: 靄(視程5km・湿度95%)は半分近くまで落ちる",
      "func": "evaluate",
      "args": [
        {
          "lpIndex": 105,
          "cloudPct": 0,
          "precipPct": 0,
          "moonBrightness": 0,
          "visibilityM": 5000,
          "humidityPct": 95
        }
      ],
      "expect": { "score": 42.4, "band": { "key": "poor" }, "hasAirQuality": true }
    },
    {
      "name": "スコア: 視程・湿度が無いときは減点せずフラグで区別する",
      "func": "evaluate",
      "args": [{ "lpIndex": 105, "cloudPct": 0, "precipPct": 0, "moonBrightness": 0 }],
      "expect": { "hasAirQuality": false }
    },
    {
      "name": "スコア: 降水確率が高い夜はほぼ不可",
      "func": "evaluate",
      "args": [{ "lpIndex": 105, "cloudPct": 60, "precipPct": 80, "moonBrightness": 0 }],
      "expect": { "score": 14.8, "band": { "key": "none" } }
    },

    {
      "name": "段階: 80はちょうど最高",
      "func": "bandOf",
      "args": [80],
      "expect": { "key": "excellent" }
    },
    {
      "name": "段階: 79.9は良い",
      "func": "bandOf",
      "args": [79.9],
      "expect": { "key": "good" }
    },
    {
      "name": "段階: 0は不可",
      "func": "bandOf",
      "args": [0],
      "expect": { "key": "none" }
    },
    {
      "name": "段階: 添字は最良が0",
      "func": "bandIndex",
      "args": [100],
      "expect": 0
    },
    {
      "name": "段階: 添字は最悪が5",
      "func": "bandIndex",
      "args": [0],
      "expect": 5
    },

    {
      "name": "月: 新月の夜(2026-08-12 東京)は輝面比0・影響なし",
      "global": "StarsMoon",
      "func": "summary",
      "args": ["2026-08-12T21:00:00+09:00", 35.68, 139.76],
      "expect": { "illuminationPct": 0, "brightness": 0, "phaseLabel": "新月" }
    },
    {
      "name": "月: 満月の夜(2026-07-29 東京)は輝面比100・高度28.2度",
      "global": "StarsMoon",
      "func": "summary",
      "args": ["2026-07-29T22:00:00+09:00", 35.68, 139.76],
      "expect": {
        "illuminationPct": 100,
        "altitudeDeg": 28.2,
        "brightness": 0.473,
        "phaseLabel": "満月"
      }
    },
    {
      "name": "月: 満月でも地平線下なら影響ゼロ",
      "global": "StarsMoon",
      "func": "summary",
      "args": ["2026-07-29T10:00:00+09:00", 35.68, 139.76],
      "expect": { "illuminationPct": 100, "altitudeDeg": -67.8, "brightness": 0 }
    },
    {
      "name": "月: 上弦(2026-08-20頃)は輝面比がおよそ半分",
      "global": "StarsMoon",
      "func": "summary",
      "args": ["2026-08-20T21:00:00+09:00", 35.68, 139.76],
      "expect": { "phaseLabel": "上弦" }
    }
  ]
}
