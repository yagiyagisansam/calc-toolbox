{
  "tool": "hensachi",
  "module": "calc.js",
  "global": "HensachiCalc",
  "cases": [
    {
      "name": "80点(平均60・標準偏差15) → 偏差値63.3",
      "func": "fromStats",
      "args": [
        80,
        60,
        15
      ],
      "expect": {
        "ok": true,
        "t": 63.3
      }
    },
    {
      "name": "45点(平均60・標準偏差15) → 偏差値40.0",
      "func": "fromStats",
      "args": [
        45,
        60,
        15
      ],
      "expect": {
        "ok": true,
        "t": 40
      }
    },
    {
      "name": "平均点ちょうどは偏差値50",
      "func": "fromStats",
      "args": [
        60,
        60,
        15
      ],
      "expect": {
        "ok": true,
        "t": 50
      }
    },
    {
      "name": "ばらつきが小さい集団では高偏差値(95点・平均70・SD8 → 81.3)",
      "func": "fromStats",
      "args": [
        95,
        70,
        8
      ],
      "expect": {
        "ok": true,
        "t": 81.3
      }
    },
    {
      "name": "点数リスト分析([80,65,70,90,55]): 平均72・SD12.08",
      "func": "analyze",
      "args": [
        [
          80,
          65,
          70,
          90,
          55
        ]
      ],
      "expect": {
        "ok": true,
        "mean": 72,
        "sd": 12.08,
        "results": [
          {
            "score": 80,
            "t": 56.6
          },
          {
            "score": 65,
            "t": 44.2
          },
          {
            "score": 70,
            "t": 48.3
          },
          {
            "score": 90,
            "t": 64.9
          },
          {
            "score": 55,
            "t": 35.9
          }
        ]
      }
    },
    {
      "name": "点数リスト分析([50,50,60]): 平均53.33・SD4.71・60点は偏差値64.1",
      "func": "analyze",
      "args": [
        [
          50,
          50,
          60
        ]
      ],
      "expect": {
        "ok": true,
        "mean": 53.33,
        "sd": 4.71
      }
    },
    {
      "name": "異常入力: 全員同じ点数は標準偏差0でエラー",
      "func": "analyze",
      "args": [
        [
          70,
          70,
          70
        ]
      ],
      "expect": {
        "ok": false,
        "code": "zero_sd"
      }
    },
    {
      "name": "異常入力: 1件だけのリストはエラー",
      "func": "analyze",
      "args": [
        [
          70
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_list"
      }
    },
    {
      "name": "異常入力: 標準偏差0はエラー",
      "func": "fromStats",
      "args": [
        80,
        60,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_sd"
      }
    },
    {
      "name": "異常入力: 負の得点はエラー",
      "func": "fromStats",
      "args": [
        -10,
        60,
        15
      ],
      "expect": {
        "ok": false,
        "code": "invalid_score"
      }
    },
    {
      "name": "異常入力: 得点が範囲超過(1001)はエラー",
      "func": "fromStats",
      "args": [
        1001,
        60,
        15
      ],
      "expect": {
        "ok": false,
        "code": "invalid_score"
      }
    },
    {
      "name": "異常入力: リスト内に数値でない値はエラー",
      "func": "analyze",
      "args": [
        [
          80,
          "abc",
          70
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_score"
      }
    },
    {
      "name": "順位換算: 偏差値60は上位15.87%・1万人中1587位",
      "func": "toRank",
      "args": [
        60,
        10000
      ],
      "expect": {
        "ok": true,
        "topPct": 15.87,
        "rank": 1587
      }
    },
    {
      "name": "順位換算: 偏差値70は上位2.28%・1万人中228位",
      "func": "toRank",
      "args": [
        70,
        10000
      ],
      "expect": {
        "ok": true,
        "topPct": 2.28,
        "rank": 228
      }
    },
    {
      "name": "順位換算: 偏差値50はちょうど上位50%",
      "func": "toRank",
      "args": [
        50,
        1000
      ],
      "expect": {
        "ok": true,
        "topPct": 50,
        "rank": 500
      }
    },
    {
      "name": "順位換算: 偏差値90でも順位は1位未満にならない",
      "func": "toRank",
      "args": [
        90,
        100
      ],
      "expect": {
        "ok": true,
        "rank": 1
      }
    },
    {
      "name": "順位換算: 受験者数が小数はエラー",
      "func": "toRank",
      "args": [
        60,
        100.5
      ],
      "expect": {
        "ok": false,
        "code": "invalid_examinees"
      }
    },
    {
      "name": "逆算: 1万人中1587位は偏差値60",
      "func": "fromRank",
      "args": [
        1587,
        10000
      ],
      "expect": {
        "ok": true,
        "t": 60
      }
    },
    {
      "name": "逆算: 1000人中500位はほぼ偏差値50",
      "func": "fromRank",
      "args": [
        500,
        1000
      ],
      "expect": {
        "ok": true,
        "t": 50
      }
    },
    {
      "name": "逆算: 順位が受験者数を超えるとエラー",
      "func": "fromRank",
      "args": [
        1001,
        1000
      ],
      "expect": {
        "ok": false,
        "code": "invalid_rank"
      }
    }
  ]
}
