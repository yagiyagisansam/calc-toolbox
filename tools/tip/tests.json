{
  "tool": "tip",
  "module": "calc.js",
  "global": "TipCalc",
  "cases": [
    {
      "name": "$80・20%・2人: チップ$16・合計$96・1人$48",
      "func": "calc",
      "args": [
        80,
        20,
        2
      ],
      "expect": {
        "ok": true,
        "tip": 16,
        "total": 96,
        "perPerson": 48
      }
    },
    {
      "name": "$85.5・18%: チップ$15.39・合計$100.89",
      "func": "calc",
      "args": [
        85.5,
        18,
        1
      ],
      "expect": {
        "ok": true,
        "tip": 15.39,
        "total": 100.89
      }
    },
    {
      "name": "$120・15%・4人: 1人$34.5",
      "func": "calc",
      "args": [
        120,
        15,
        4
      ],
      "expect": {
        "ok": true,
        "tip": 18,
        "total": 138,
        "perPerson": 34.5
      }
    },
    {
      "name": "人数省略は1人扱い",
      "func": "calc",
      "args": [
        100,
        20
      ],
      "expect": {
        "ok": true,
        "tip": 20,
        "total": 120,
        "perPerson": 120
      }
    },
    {
      "name": "チップ0%も計算できる(サービス料込みの店)",
      "func": "calc",
      "args": [
        100,
        0,
        2
      ],
      "expect": {
        "ok": true,
        "tip": 0,
        "total": 100,
        "perPerson": 50
      }
    },
    {
      "name": "異常入力: 金額0はエラー",
      "func": "calc",
      "args": [
        0,
        20
      ],
      "expect": {
        "ok": false,
        "code": "invalid_amount"
      }
    },
    {
      "name": "異常入力: チップ率51%はエラー",
      "func": "calc",
      "args": [
        100,
        51
      ],
      "expect": {
        "ok": false,
        "code": "invalid_pct"
      }
    },
    {
      "name": "異常入力: 人数0はエラー",
      "func": "calc",
      "args": [
        100,
        20,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_people"
      }
    },
    {
      "name": "異常入力: 人数が小数はエラー",
      "func": "calc",
      "args": [
        100,
        20,
        2.5
      ],
      "expect": {
        "ok": false,
        "code": "invalid_people"
      }
    },
    {
      "name": "逆算: 100ドルの会計で118ドル払ったらチップ18%(標準を満たす)",
      "func": "reverse",
      "args": [
        118,
        100
      ],
      "expect": {
        "ok": true,
        "tip": 18,
        "pct": 18,
        "verdict": "enough"
      }
    },
    {
      "name": "逆算: 105.5ドル払いは5.5%(少なめ)",
      "func": "reverse",
      "args": [
        105.5,
        100
      ],
      "expect": {
        "ok": true,
        "tip": 5.5,
        "pct": 5.5,
        "verdict": "low"
      }
    },
    {
      "name": "逆算: 同額支払いはチップ0%(none)",
      "func": "reverse",
      "args": [
        100,
        100
      ],
      "expect": {
        "ok": true,
        "tip": 0,
        "pct": 0,
        "verdict": "none"
      }
    },
    {
      "name": "逆算: 支払い総額が元の金額より少ないのはエラー",
      "func": "reverse",
      "args": [
        90,
        100
      ],
      "expect": {
        "ok": false,
        "code": "invalid_paid"
      }
    },
    {
      "name": "サービス料判定: 18%込みなら追加チップ不要",
      "func": "serviceAdvice",
      "args": [
        100,
        18
      ],
      "expect": {
        "ok": true,
        "need": false,
        "add15": 0,
        "add18": 0
      }
    },
    {
      "name": "サービス料判定: 10%込みなら15%まで+5、18%まで+8が目安",
      "func": "serviceAdvice",
      "args": [
        100,
        10
      ],
      "expect": {
        "ok": true,
        "need": true,
        "add15": 5,
        "add18": 8
      }
    },
    {
      "name": "サービス料判定: 50%超の率はエラー",
      "func": "serviceAdvice",
      "args": [
        100,
        60
      ],
      "expect": {
        "ok": false,
        "code": "invalid_pct"
      }
    }
  ]
}
