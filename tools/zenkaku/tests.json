{
  "tool": "zenkaku",
  "module": "calc.js",
  "global": "ZenkakuCalc",
  "cases": [
    {
      "name": "全角英数→半角: ＡＢＣ１２３ → ABC123",
      "func": "toHankaku",
      "args": [
        "ＡＢＣ１２３"
      ],
      "expect": {
        "ok": true,
        "text": "ABC123",
        "changed": 6
      }
    },
    {
      "name": "全角記号とハイフンも変換: ＴＥＬ：０３−…→TEL:03-",
      "func": "toHankaku",
      "args": [
        "ＴＥＬ：０３"
      ],
      "expect": {
        "ok": true,
        "text": "TEL:03",
        "changed": 6
      }
    },
    {
      "name": "全角スペース→半角スペース",
      "func": "toHankaku",
      "args": [
        "あ　い"
      ],
      "expect": {
        "ok": true,
        "text": "あ い",
        "changed": 1
      }
    },
    {
      "name": "かな・漢字は変換しない",
      "func": "toHankaku",
      "args": [
        "東京都ＡＢＣアイウ"
      ],
      "expect": {
        "ok": true,
        "text": "東京都ABCアイウ",
        "changed": 3
      }
    },
    {
      "name": "変換対象がなければそのまま(changed=0)",
      "func": "toHankaku",
      "args": [
        "hello 123"
      ],
      "expect": {
        "ok": true,
        "text": "hello 123",
        "changed": 0
      }
    },
    {
      "name": "半角→全角: abc 12 → ａｂｃ　１２",
      "func": "toZenkaku",
      "args": [
        "abc 12"
      ],
      "expect": {
        "ok": true,
        "text": "ａｂｃ　１２",
        "changed": 6
      }
    },
    {
      "name": "全角化: A1! → Ａ１！",
      "func": "toZenkaku",
      "args": [
        "A1!"
      ],
      "expect": {
        "ok": true,
        "text": "Ａ１！",
        "changed": 3
      }
    },
    {
      "name": "空文字はそのまま",
      "func": "toHankaku",
      "args": [
        ""
      ],
      "expect": {
        "ok": true,
        "text": "",
        "changed": 0
      }
    },
    {
      "name": "異常入力: 文字列以外はエラー",
      "func": "toHankaku",
      "args": [
        123
      ],
      "expect": {
        "ok": false,
        "code": "invalid_text"
      }
    },
    {
      "name": "選択変換: 英数字のみONで記号は残る",
      "func": "convertSelective",
      "args": [
        "ＡＢＣ１２３！",
        "toHankaku",
        {
          "alnum": true,
          "kana": false,
          "symbol": false,
          "space": false
        }
      ],
      "expect": {
        "ok": true,
        "text": "ABC123！",
        "changed": 6
      }
    },
    {
      "name": "選択変換: 記号とスペースのみON(英数字は残る)",
      "func": "convertSelective",
      "args": [
        "テスト！　１２３",
        "toHankaku",
        {
          "alnum": false,
          "kana": false,
          "symbol": true,
          "space": true
        }
      ],
      "expect": {
        "ok": true,
        "text": "テスト! １２３",
        "changed": 2
      }
    },
    {
      "name": "選択変換: カタカナ→半角カナ(濁点は分解してｶﾞ)",
      "func": "convertSelective",
      "args": [
        "ガンダム",
        "toHankaku",
        {
          "alnum": false,
          "kana": true,
          "symbol": false,
          "space": false
        }
      ],
      "expect": {
        "ok": true,
        "text": "ｶﾞﾝﾀﾞﾑ",
        "changed": 4
      }
    },
    {
      "name": "選択変換: 半角カナ→全角カタカナ(ｶﾞは合成してガ)",
      "func": "convertSelective",
      "args": [
        "ｶﾞｰﾙ",
        "toZenkaku",
        {
          "alnum": false,
          "kana": true,
          "symbol": false,
          "space": false
        }
      ],
      "expect": {
        "ok": true,
        "text": "ガール",
        "changed": 4
      }
    },
    {
      "name": "選択変換: すべてOFFなら何も変わらない",
      "func": "convertSelective",
      "args": [
        "ＡＢＣ　ｱｲｳ",
        "toHankaku",
        {
          "alnum": false,
          "kana": false,
          "symbol": false,
          "space": false
        }
      ],
      "expect": {
        "ok": true,
        "text": "ＡＢＣ　ｱｲｳ",
        "changed": 0
      }
    },
    {
      "name": "選択変換: 文字列以外はエラー",
      "func": "convertSelective",
      "args": [
        123,
        "toHankaku",
        {
          "alnum": true
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalid_text"
      }
    },
    {
      "name": "混在チェック: ABC１23 は4文字目の１が全角英数字",
      "func": "findMixed",
      "args": [
        "ABC１23"
      ],
      "expect": {
        "ok": true,
        "total": 1,
        "counts": {
          "zen_alnum": 1,
          "zen_symbol": 0,
          "zen_space": 0,
          "han_kana": 0
        },
        "items": [
          {
            "ch": "１",
            "index": 3,
            "type": "zen_alnum"
          }
        ]
      }
    },
    {
      "name": "混在チェック: 半角カナと全角スペースを検出",
      "func": "findMixed",
      "args": [
        "ｱｲ　x"
      ],
      "expect": {
        "ok": true,
        "total": 3,
        "counts": {
          "zen_alnum": 0,
          "zen_symbol": 0,
          "zen_space": 1,
          "han_kana": 2
        }
      }
    },
    {
      "name": "混在チェック: 半角だけなら0件",
      "func": "findMixed",
      "args": [
        "abc 123!"
      ],
      "expect": {
        "ok": true,
        "total": 0
      }
    }
  ]
}
