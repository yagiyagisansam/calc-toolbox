{
  "tool": "spoon",
  "module": "calc.js",
  "global": "SpoonCalc",
  "cases": [
    {
      "name": "大さじ3 = 45ml = 小さじ9",
      "func": "convert",
      "args": [
        3,
        "tbsp"
      ],
      "expect": {
        "ok": true,
        "ml": 45,
        "tsp": 9,
        "cup": 0.23
      }
    },
    {
      "name": "100ml = 大さじ6.67 = 小さじ20 = 0.5カップ",
      "func": "convert",
      "args": [
        100,
        "ml"
      ],
      "expect": {
        "ok": true,
        "tbsp": 6.67,
        "tsp": 20,
        "cup": 0.5
      }
    },
    {
      "name": "1カップ = 200ml = 大さじ13.33",
      "func": "convert",
      "args": [
        1,
        "cup"
      ],
      "expect": {
        "ok": true,
        "ml": 200,
        "tbsp": 13.33,
        "tsp": 40
      }
    },
    {
      "name": "小さじ1 = 5ml = 大さじ1/3",
      "func": "convert",
      "args": [
        1,
        "tsp"
      ],
      "expect": {
        "ok": true,
        "ml": 5,
        "tbsp": 0.33
      }
    },
    {
      "name": "大さじ1 = 小さじ3",
      "func": "convert",
      "args": [
        1,
        "tbsp"
      ],
      "expect": {
        "ok": true,
        "ml": 15,
        "tsp": 3
      }
    },
    {
      "name": "0.5カップ = 100ml",
      "func": "convert",
      "args": [
        0.5,
        "cup"
      ],
      "expect": {
        "ok": true,
        "ml": 100
      }
    },
    {
      "name": "異常入力: 0はエラー",
      "func": "convert",
      "args": [
        0,
        "tbsp"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "異常入力: 負の値はエラー",
      "func": "convert",
      "args": [
        -1,
        "ml"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "異常入力: 不正な単位はエラー",
      "func": "convert",
      "args": [
        1,
        "oz"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_unit"
      }
    },
    {
      "name": "重さ換算: 砂糖大さじ1は約9g",
      "func": "toGrams",
      "args": [
        1,
        0,
        "sugar"
      ],
      "expect": {
        "ok": true,
        "grams": 9,
        "gramsPerTbsp": 9,
        "gramsPerTsp": 3
      }
    },
    {
      "name": "重さ換算: しょうゆ大さじ2+小さじ1は42g",
      "func": "toGrams",
      "args": [
        2,
        1,
        "soy"
      ],
      "expect": {
        "ok": true,
        "grams": 42
      }
    },
    {
      "name": "重さ換算: 水は大さじ1=15g(容量と同じ)",
      "func": "toGrams",
      "args": [
        1,
        0,
        "water"
      ],
      "expect": {
        "ok": true,
        "grams": 15
      }
    },
    {
      "name": "重さ換算: 杯数が両方0はエラー",
      "func": "toGrams",
      "args": [
        0,
        0,
        "sugar"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_amount"
      }
    },
    {
      "name": "重さ換算: 未対応の材料はエラー",
      "func": "toGrams",
      "args": [
        1,
        0,
        "butter"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_material"
      }
    },
    {
      "name": "逆換算: 砂糖30gは大さじ3+小さじ1",
      "func": "fromGrams",
      "args": [
        30,
        "sugar"
      ],
      "expect": {
        "ok": true,
        "tbsp": 3.33,
        "tsp": 10,
        "tbspWhole": 3,
        "tspRest": 1
      }
    },
    {
      "name": "逆換算: 水45gは大さじ3ちょうど",
      "func": "fromGrams",
      "args": [
        45,
        "water"
      ],
      "expect": {
        "ok": true,
        "tbsp": 3,
        "tbspWhole": 3,
        "tspRest": 0
      }
    },
    {
      "name": "逆換算: 0gはエラー",
      "func": "fromGrams",
      "args": [
        0,
        "sugar"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    }
  ]
}
