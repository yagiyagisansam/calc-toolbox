{
  "tool": "seiza",
  "module": "calc.js",
  "global": "SeizaCalc",
  "cases": [
    {
      "name": "3/21 → おひつじ座(境界の初日)",
      "func": "lookup",
      "args": [
        3,
        21
      ],
      "expect": {
        "ok": true,
        "sign": "おひつじ座",
        "signEn": "Aries",
        "stone": "アクアマリン"
      }
    },
    {
      "name": "4/19 → おひつじ座(境界の最終日)",
      "func": "lookup",
      "args": [
        4,
        19
      ],
      "expect": {
        "ok": true,
        "sign": "おひつじ座"
      }
    },
    {
      "name": "4/20 → おうし座(境界の切り替わり)",
      "func": "lookup",
      "args": [
        4,
        20
      ],
      "expect": {
        "ok": true,
        "sign": "おうし座",
        "stone": "ダイヤモンド"
      }
    },
    {
      "name": "1/10 → やぎ座(年またぎの星座)",
      "func": "lookup",
      "args": [
        1,
        10
      ],
      "expect": {
        "ok": true,
        "sign": "やぎ座",
        "stone": "ガーネット"
      }
    },
    {
      "name": "12/25 → やぎ座",
      "func": "lookup",
      "args": [
        12,
        25
      ],
      "expect": {
        "ok": true,
        "sign": "やぎ座",
        "stone": "ターコイズ(トルコ石)"
      }
    },
    {
      "name": "7/24 → しし座",
      "func": "lookup",
      "args": [
        7,
        24
      ],
      "expect": {
        "ok": true,
        "sign": "しし座",
        "stone": "ルビー"
      }
    },
    {
      "name": "2/29(うるう日)→ うお座",
      "func": "lookup",
      "args": [
        2,
        29
      ],
      "expect": {
        "ok": true,
        "sign": "うお座",
        "stone": "アメシスト"
      }
    },
    {
      "name": "9/22 → おとめ座 / 9/23 → てんびん座",
      "func": "lookup",
      "args": [
        9,
        23
      ],
      "expect": {
        "ok": true,
        "sign": "てんびん座"
      }
    },
    {
      "name": "異常入力: 2/30はエラー",
      "func": "lookup",
      "args": [
        2,
        30
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    },
    {
      "name": "異常入力: 13月はエラー",
      "func": "lookup",
      "args": [
        13,
        1
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    },
    {
      "name": "詳細: 2000年1月1日は土曜日・やぎ座・カスプなし",
      "func": "detail",
      "args": [
        2000,
        1,
        1
      ],
      "expect": {
        "ok": true,
        "youbi": "土曜日",
        "dow": 6,
        "sign": "やぎ座",
        "cusp": null
      }
    },
    {
      "name": "詳細: 1990年4月20日は金曜日・おうし座(おひつじ座とのカスプ)",
      "func": "detail",
      "args": [
        1990,
        4,
        20
      ],
      "expect": {
        "ok": true,
        "youbi": "金曜日",
        "sign": "おうし座",
        "cusp": {
          "otherSign": "おひつじ座",
          "boundaryM": 4,
          "boundaryD": 20
        }
      }
    },
    {
      "name": "詳細: 4月19日はおひつじ座だがおうし座とのカスプ注記",
      "func": "detail",
      "args": [
        1990,
        4,
        19
      ],
      "expect": {
        "ok": true,
        "sign": "おひつじ座",
        "cusp": {
          "otherSign": "おうし座"
        }
      }
    },
    {
      "name": "詳細: 2024年2月29日(うるう年)は木曜日・うお座",
      "func": "detail",
      "args": [
        2024,
        2,
        29
      ],
      "expect": {
        "ok": true,
        "youbi": "木曜日",
        "dow": 4,
        "sign": "うお座"
      }
    },
    {
      "name": "詳細: 2023年2月29日は存在しないのでエラー",
      "func": "detail",
      "args": [
        2023,
        2,
        29
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    },
    {
      "name": "詳細: 範囲外の年(1500年)はエラー",
      "func": "detail",
      "args": [
        1500,
        1,
        1
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    }
  ]
}
