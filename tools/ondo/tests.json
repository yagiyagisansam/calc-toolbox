{
  "tool": "ondo",
  "module": "calc.js",
  "global": "OndoCalc",
  "cases": [
    {
      "name": "100°C = 212°F = 373.15K(水の沸点)",
      "func": "convert",
      "args": [
        100,
        "c"
      ],
      "expect": {
        "ok": true,
        "c": 100,
        "f": 212,
        "k": 373.15
      }
    },
    {
      "name": "98.6°F = 37°C = 310.15K",
      "func": "convert",
      "args": [
        98.6,
        "f"
      ],
      "expect": {
        "ok": true,
        "c": 37,
        "f": 98.6,
        "k": 310.15
      }
    },
    {
      "name": "0K = -273.15°C = -459.67°F(絶対零度)",
      "func": "convert",
      "args": [
        0,
        "k"
      ],
      "expect": {
        "ok": true,
        "c": -273.15,
        "f": -459.67,
        "k": 0
      }
    },
    {
      "name": "36.5°C = 97.7°F = 309.65K(平熱の目安)",
      "func": "convert",
      "args": [
        36.5,
        "c"
      ],
      "expect": {
        "ok": true,
        "c": 36.5,
        "f": 97.7,
        "k": 309.65
      }
    },
    {
      "name": "-40°Cと-40°Fは同じ温度",
      "func": "convert",
      "args": [
        -40,
        "c"
      ],
      "expect": {
        "ok": true,
        "c": -40,
        "f": -40,
        "k": 233.15
      }
    },
    {
      "name": "0°C = 32°F(水の融点)",
      "func": "convert",
      "args": [
        0,
        "c"
      ],
      "expect": {
        "ok": true,
        "c": 0,
        "f": 32,
        "k": 273.15
      }
    },
    {
      "name": "異常入力: 絶対零度未満(-300°C)はエラー",
      "func": "convert",
      "args": [
        -300,
        "c"
      ],
      "expect": {
        "ok": false,
        "code": "below_absolute_zero"
      }
    },
    {
      "name": "異常入力: 絶対零度未満(-500°F)はエラー",
      "func": "convert",
      "args": [
        -500,
        "f"
      ],
      "expect": {
        "ok": false,
        "code": "below_absolute_zero"
      }
    },
    {
      "name": "異常入力: 不正な単位はエラー",
      "func": "convert",
      "args": [
        100,
        "x"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_unit"
      }
    },
    {
      "name": "異常入力: 数値以外はエラー",
      "func": "convert",
      "args": [
        "hot",
        "c"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "早見表: 0〜100°Cを25刻みで5行(0/32〜100/212)",
      "func": "makeTable",
      "args": [
        0,
        100,
        25,
        "c"
      ],
      "expect": {
        "ok": true,
        "count": 5,
        "rows": {
          "0": {
            "c": 0,
            "f": 32
          },
          "2": {
            "c": 50,
            "f": 122
          },
          "4": {
            "c": 100,
            "f": 212
          }
        }
      }
    },
    {
      "name": "早見表: 300〜450°Fを50刻みで4行(300°F=148.89°C)",
      "func": "makeTable",
      "args": [
        300,
        450,
        50,
        "f"
      ],
      "expect": {
        "ok": true,
        "count": 4,
        "rows": {
          "0": {
            "c": 148.89,
            "f": 300
          },
          "3": {
            "c": 232.22,
            "f": 450
          }
        }
      }
    },
    {
      "name": "早見表: 開始と終了が同じなら1行",
      "func": "makeTable",
      "args": [
        37,
        37,
        1,
        "c"
      ],
      "expect": {
        "ok": true,
        "count": 1,
        "rows": {
          "0": {
            "c": 37,
            "f": 98.6
          }
        }
      }
    },
    {
      "name": "早見表: 刻み0はエラー",
      "func": "makeTable",
      "args": [
        0,
        100,
        0,
        "c"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_step"
      }
    },
    {
      "name": "早見表: 終了が開始より小さいとエラー",
      "func": "makeTable",
      "args": [
        100,
        0,
        10,
        "c"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_range"
      }
    },
    {
      "name": "早見表: 101行を超えるとエラー",
      "func": "makeTable",
      "args": [
        0,
        102,
        1,
        "c"
      ],
      "expect": {
        "ok": false,
        "code": "too_many_rows"
      }
    },
    {
      "name": "オーブン: 350°F→176.67°C・設定目安180°C・ガスマーク4",
      "func": "ovenSetting",
      "args": [
        350
      ],
      "expect": {
        "ok": true,
        "cExact": 176.67,
        "cOven": 180,
        "gasMark": 4
      }
    },
    {
      "name": "オーブン: 425°F→218.33°C・設定目安220°C・ガスマーク7",
      "func": "ovenSetting",
      "args": [
        425
      ],
      "expect": {
        "ok": true,
        "cExact": 218.33,
        "cOven": 220,
        "gasMark": 7
      }
    },
    {
      "name": "オーブン: 250°Fはガスマーク範囲外でnull",
      "func": "ovenSetting",
      "args": [
        250
      ],
      "expect": {
        "ok": true,
        "cExact": 121.11,
        "cOven": 120,
        "gasMark": null
      }
    },
    {
      "name": "オーブン: 範囲外(650°F)はエラー",
      "func": "ovenSetting",
      "args": [
        650
      ],
      "expect": {
        "ok": false,
        "code": "out_of_range"
      }
    }
  ]
}
