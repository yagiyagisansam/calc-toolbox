{
  "tool": "teiki",
  "module": "calc.js",
  "global": "TeikiCalc",
  "cases": [
    {
      "name": "定期1万円・片道200円・22日: 都度8,800円で都度払いが得(分岐25日)",
      "func": "compare",
      "args": [
        10000,
        200,
        22
      ],
      "expect": {
        "ok": true,
        "payg": 8800,
        "diff": -1200,
        "breakEvenDays": 25,
        "better": "payg"
      }
    },
    {
      "name": "定期8,000円・片道200円・22日: 定期が800円得(分岐20日)",
      "func": "compare",
      "args": [
        8000,
        200,
        22
      ],
      "expect": {
        "ok": true,
        "payg": 8800,
        "diff": 800,
        "breakEvenDays": 20,
        "better": "pass"
      }
    },
    {
      "name": "ちょうど同額なら互角",
      "func": "compare",
      "args": [
        8800,
        200,
        22
      ],
      "expect": {
        "ok": true,
        "diff": 0,
        "better": "even"
      }
    },
    {
      "name": "週3出社(月13日)では定期は元が取れない例",
      "func": "compare",
      "args": [
        10000,
        250,
        13
      ],
      "expect": {
        "ok": true,
        "payg": 6500,
        "better": "payg",
        "breakEvenDays": 20
      }
    },
    {
      "name": "分岐日数は切り上げ(定期9,900円・片道200円→25日)",
      "func": "compare",
      "args": [
        9900,
        200,
        20
      ],
      "expect": {
        "ok": true,
        "breakEvenDays": 25
      }
    },
    {
      "name": "異常入力: 定期価格0はエラー",
      "func": "compare",
      "args": [
        0,
        200,
        22
      ],
      "expect": {
        "ok": false,
        "code": "invalid_pass"
      }
    },
    {
      "name": "異常入力: 運賃0はエラー",
      "func": "compare",
      "args": [
        10000,
        0,
        22
      ],
      "expect": {
        "ok": false,
        "code": "invalid_fare"
      }
    },
    {
      "name": "異常入力: 32日はエラー",
      "func": "compare",
      "args": [
        10000,
        200,
        32
      ],
      "expect": {
        "ok": false,
        "code": "invalid_days"
      }
    },
    {
      "name": "定期比較: 1万/2.85万/5.4万・片道300円・月20日 → 6ヶ月定期が最安",
      "func": "comparePasses",
      "args": [
        10000,
        28500,
        54000,
        300,
        20
      ],
      "expect": {
        "ok": true,
        "payg": 12000,
        "perMonth1": 10000,
        "perMonth3": 9500,
        "perMonth6": 9000,
        "breakEven1": 17,
        "breakEven3": 16,
        "breakEven6": 15,
        "year1": 120000,
        "year3": 114000,
        "year6": 108000,
        "best": "m6"
      }
    },
    {
      "name": "定期比較: 月8日しか乗らないなら都度払いが最安",
      "func": "comparePasses",
      "args": [
        6000,
        18000,
        36000,
        300,
        8
      ],
      "expect": {
        "ok": true,
        "payg": 4800,
        "perMonth1": 6000,
        "breakEven1": 10,
        "best": "payg"
      }
    },
    {
      "name": "定期比較: 同額の場合は柔軟な都度払いを選ぶ(境界)",
      "func": "comparePasses",
      "args": [
        10000,
        30000,
        60000,
        250,
        20
      ],
      "expect": {
        "ok": true,
        "payg": 10000,
        "perMonth3": 10000,
        "breakEven1": 20,
        "best": "payg"
      }
    },
    {
      "name": "定期比較: 3ヶ月定期の価格0はエラー",
      "func": "comparePasses",
      "args": [
        10000,
        0,
        54000,
        300,
        20
      ],
      "expect": {
        "ok": false,
        "code": "invalid_pass3"
      }
    },
    {
      "name": "定期比較: 利用日数0はエラー",
      "func": "comparePasses",
      "args": [
        10000,
        28500,
        54000,
        300,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_days"
      }
    }
  ]
}
