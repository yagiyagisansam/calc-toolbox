{
  "tool": "byte",
  "module": "calc.js",
  "global": "ByteCalc",
  "cases": [
    {
      "name": "1GB(1024換算)= 1024MB = 1,048,576KB",
      "func": "convert",
      "args": [
        1,
        "gb",
        1024
      ],
      "expect": {
        "ok": true,
        "mb": 1024,
        "kb": 1048576,
        "b": 1073741824,
        "tb": 0.001
      }
    },
    {
      "name": "500MB(1000換算)= 0.5GB = 500,000KB",
      "func": "convert",
      "args": [
        500,
        "mb",
        1000
      ],
      "expect": {
        "ok": true,
        "gb": 0.5,
        "kb": 500000,
        "tb": 0.0005
      }
    },
    {
      "name": "2TB(1024換算)= 2048GB",
      "func": "convert",
      "args": [
        2,
        "tb",
        1024
      ],
      "expect": {
        "ok": true,
        "gb": 2048
      }
    },
    {
      "name": "DVD一層 4.7GB(1000換算)= 4700MB",
      "func": "convert",
      "args": [
        4700,
        "mb",
        1000
      ],
      "expect": {
        "ok": true,
        "gb": 4.7
      }
    },
    {
      "name": "1024B = 1KB(1024換算)",
      "func": "convert",
      "args": [
        1024,
        "b",
        1024
      ],
      "expect": {
        "ok": true,
        "kb": 1,
        "mb": 0.001
      }
    },
    {
      "name": "異常入力: 0はエラー",
      "func": "convert",
      "args": [
        0,
        "gb",
        1024
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "異常入力: 負の値はエラー",
      "func": "convert",
      "args": [
        -5,
        "gb",
        1024
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "異常入力: 不正な単位はエラー",
      "func": "convert",
      "args": [
        1,
        "pb",
        1024
      ],
      "expect": {
        "ok": false,
        "code": "invalid_unit"
      }
    },
    {
      "name": "異常入力: 基数が1024/1000以外はエラー",
      "func": "convert",
      "args": [
        1,
        "gb",
        512
      ],
      "expect": {
        "ok": false,
        "code": "invalid_base"
      }
    },
    {
      "name": "ダウンロード時間: 100MB(1000換算)を100Mbpsで理論8秒",
      "func": "downloadTime",
      "args": [
        100,
        "mb",
        100,
        1000
      ],
      "expect": {
        "ok": true,
        "seconds": 8,
        "secondsEffective": 11.43,
        "mbPerSec": 12.5
      }
    },
    {
      "name": "ダウンロード時間: 1GB(1000換算)を40Mbpsで理論200秒",
      "func": "downloadTime",
      "args": [
        1,
        "gb",
        40,
        1000
      ],
      "expect": {
        "ok": true,
        "seconds": 200,
        "secondsEffective": 285.71,
        "mbPerSec": 5
      }
    },
    {
      "name": "ダウンロード時間: 1GB(1024換算)を100Mbpsで理論85.9秒",
      "func": "downloadTime",
      "args": [
        1,
        "gb",
        100,
        1024
      ],
      "expect": {
        "ok": true,
        "seconds": 85.9,
        "bytes": 1073741824
      }
    },
    {
      "name": "ダウンロード時間: 速度0はエラー",
      "func": "downloadTime",
      "args": [
        1,
        "gb",
        0,
        1024
      ],
      "expect": {
        "ok": false,
        "code": "invalid_speed"
      }
    },
    {
      "name": "ダウンロード時間: 容量が負はエラー",
      "func": "downloadTime",
      "args": [
        -1,
        "gb",
        100,
        1024
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "容量の目安: 8GB(1000換算)は写真2000枚・音楽1000曲・動画4時間",
      "func": "capacityUsage",
      "args": [
        8,
        "gb",
        1000
      ],
      "expect": {
        "ok": true,
        "photos": 2000,
        "songs": 1000,
        "videoHours": 4
      }
    },
    {
      "name": "容量の目安: 512GB(1000換算)は写真128,000枚",
      "func": "capacityUsage",
      "args": [
        512,
        "gb",
        1000
      ],
      "expect": {
        "ok": true,
        "photos": 128000,
        "songs": 64000,
        "videoHours": 256
      }
    },
    {
      "name": "容量の目安: 単位が不正ならエラー",
      "func": "capacityUsage",
      "args": [
        1,
        "xx",
        1000
      ],
      "expect": {
        "ok": false,
        "code": "invalid_unit"
      }
    }
  ]
}
