{
  "tool": "eigyobi",
  "module": "calc.js",
  "global": "EigyobiCalc",
  "cases": [
    {
      "name": "金曜(2026-07-24)の3営業日後 → 翌週水曜7/29",
      "func": "addBusinessDays",
      "args": [
        "2026-07-24",
        3
      ],
      "expect": {
        "ok": true,
        "date": "2026-07-29",
        "weekday": "水"
      }
    },
    {
      "name": "海の日をまたぐ: 7/17(金)の2営業日後 → 7/22(祝月曜を飛ばす)",
      "func": "addBusinessDays",
      "args": [
        "2026-07-17",
        2
      ],
      "expect": {
        "ok": true,
        "date": "2026-07-22",
        "weekday": "水"
      }
    },
    {
      "name": "GWをまたぐ: 4/30(木)の2営業日後 → 5/7(5/2〜6は土日祝・振替)",
      "func": "addBusinessDays",
      "args": [
        "2026-04-30",
        2
      ],
      "expect": {
        "ok": true,
        "date": "2026-05-07",
        "weekday": "木"
      }
    },
    {
      "name": "シルバーウィーク2026: 9/18(金)〜9/25(金)の営業日は3日",
      "func": "countBusinessDays",
      "args": [
        "2026-09-18",
        "2026-09-25"
      ],
      "expect": {
        "ok": true,
        "businessDays": 3,
        "totalDays": 8
      }
    },
    {
      "name": "1営業日後(平日連続)",
      "func": "addBusinessDays",
      "args": [
        "2026-07-27",
        1
      ],
      "expect": {
        "ok": true,
        "date": "2026-07-28",
        "weekday": "火"
      }
    },
    {
      "name": "2027年の振替休日: 3/19(金)の1営業日後は3/23(3/21春分が日曜→3/22振替)",
      "func": "addBusinessDays",
      "args": [
        "2027-03-19",
        1
      ],
      "expect": {
        "ok": true,
        "date": "2027-03-23"
      }
    },
    {
      "name": "期間カウント: 2026-07-20(祝)〜07-24 → 4営業日",
      "func": "countBusinessDays",
      "args": [
        "2026-07-20",
        "2026-07-24"
      ],
      "expect": {
        "ok": true,
        "businessDays": 4,
        "totalDays": 5
      }
    },
    {
      "name": "異常入力: 対応範囲外(2025年)はエラー",
      "func": "addBusinessDays",
      "args": [
        "2025-12-01",
        3
      ],
      "expect": {
        "ok": false,
        "code": "out_of_range"
      }
    },
    {
      "name": "異常入力: 営業日数0はエラー",
      "func": "addBusinessDays",
      "args": [
        "2026-07-24",
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_n"
      }
    },
    {
      "name": "異常入力: 終了日が開始日より前はエラー",
      "func": "countBusinessDays",
      "args": [
        "2026-07-24",
        "2026-07-20"
      ],
      "expect": {
        "ok": false,
        "code": "date_order"
      }
    },
    {
      "name": "会社休業日なしは通常の営業日計算と同じ(7/16木の3営業日後は祝日を飛ばして7/22水)",
      "func": "addBusinessDaysCustom",
      "args": [
        "2026-07-16",
        3,
        "",
        false
      ],
      "expect": {
        "ok": true,
        "date": "2026-07-22",
        "weekday": "水",
        "customCount": 0
      }
    },
    {
      "name": "会社休業日(カンマ区切り・スラッシュ形式混在)を飛ばして計算",
      "func": "addBusinessDaysCustom",
      "args": [
        "2026-07-16",
        3,
        "2026-07-21, 2026/7/22",
        false
      ],
      "expect": {
        "ok": true,
        "date": "2026-07-24",
        "weekday": "金",
        "customCount": 2
      }
    },
    {
      "name": "土曜営業なら土曜も1営業日と数える(7/16木の3営業日後は7/21火)",
      "func": "addBusinessDaysCustom",
      "args": [
        "2026-07-16",
        3,
        "",
        true
      ],
      "expect": {
        "ok": true,
        "date": "2026-07-21",
        "weekday": "火",
        "customCount": 0
      }
    },
    {
      "name": "休業日リストに読めない項目があればエラー",
      "func": "addBusinessDaysCustom",
      "args": [
        "2026-07-16",
        3,
        "2026-07-xx",
        false
      ],
      "expect": {
        "ok": false,
        "code": "invalid_holidays"
      }
    },
    {
      "name": "期間の営業日数: 7/20(祝)〜7/26は4営業日、会社休業日を1件入れると3営業日",
      "func": "countBusinessDaysCustom",
      "args": [
        "2026-07-20",
        "2026-07-26",
        "2026-07-23",
        false
      ],
      "expect": {
        "ok": true,
        "businessDays": 3,
        "totalDays": 7,
        "customCount": 1
      }
    },
    {
      "name": "期間の営業日数: 土曜営業なら7/20〜7/26は5営業日(休業日なし)",
      "func": "countBusinessDaysCustom",
      "args": [
        "2026-07-20",
        "2026-07-26",
        "",
        true
      ],
      "expect": {
        "ok": true,
        "businessDays": 5,
        "totalDays": 7,
        "customCount": 0
      }
    },
    {
      "name": "期間の営業日数: 終了日が前ならエラー",
      "func": "countBusinessDaysCustom",
      "args": [
        "2026-07-26",
        "2026-07-20",
        "",
        false
      ],
      "expect": {
        "ok": false,
        "code": "date_order"
      }
    }
  ]
}
