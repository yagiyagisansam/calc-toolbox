{
  "tool": "tsukisu",
  "module": "calc.js",
  "global": "TsukisuCalc",
  "cases": [
    {
      "name": "2026-07-24の3ヶ月後 → 2026-10-24",
      "func": "addMonths",
      "args": [
        "2026-07-24",
        3
      ],
      "expect": {
        "ok": true,
        "date": "2026-10-24",
        "clamped": false
      }
    },
    {
      "name": "月末調整: 1/31の1ヶ月後 → 2/28",
      "func": "addMonths",
      "args": [
        "2026-01-31",
        1
      ],
      "expect": {
        "ok": true,
        "date": "2026-02-28",
        "clamped": true
      }
    },
    {
      "name": "うるう年: 2024-01-31の1ヶ月後 → 2/29",
      "func": "addMonths",
      "args": [
        "2024-01-31",
        1
      ],
      "expect": {
        "ok": true,
        "date": "2024-02-29",
        "clamped": true
      }
    },
    {
      "name": "年またぎ: 2026-11-15の3ヶ月後 → 2027-02-15",
      "func": "addMonths",
      "args": [
        "2026-11-15",
        3
      ],
      "expect": {
        "ok": true,
        "date": "2027-02-15"
      }
    },
    {
      "name": "○ヶ月前(負の月数): 2026-03-31の1ヶ月前 → 2/28",
      "func": "addMonths",
      "args": [
        "2026-03-31",
        -1
      ],
      "expect": {
        "ok": true,
        "date": "2026-02-28",
        "clamped": true
      }
    },
    {
      "name": "月数差: 1/15〜7/24は満6ヶ月と9日",
      "func": "monthsBetween",
      "args": [
        "2026-01-15",
        "2026-07-24"
      ],
      "expect": {
        "ok": true,
        "months": 6,
        "extraDays": 9
      }
    },
    {
      "name": "月数差: 日が足りなければ満5ヶ月(1/25〜7/24)",
      "func": "monthsBetween",
      "args": [
        "2026-01-25",
        "2026-07-24"
      ],
      "expect": {
        "ok": true,
        "months": 5,
        "extraDays": 29
      }
    },
    {
      "name": "同日なら0ヶ月0日",
      "func": "monthsBetween",
      "args": [
        "2026-07-24",
        "2026-07-24"
      ],
      "expect": {
        "ok": true,
        "months": 0,
        "extraDays": 0
      }
    },
    {
      "name": "異常入力: 逆順の日付はエラー",
      "func": "monthsBetween",
      "args": [
        "2026-07-24",
        "2026-01-15"
      ],
      "expect": {
        "ok": false,
        "code": "date_order"
      }
    },
    {
      "name": "異常入力: 存在しない日付はエラー",
      "func": "addMonths",
      "args": [
        "2026-02-30",
        1
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    },
    {
      "name": "更新一覧: 1/31開始・1ヶ月ごと3回→2/28(調整)・3/31・4/30(調整)",
      "func": "renewalDates",
      "args": [
        "2026-01-31",
        1,
        3,
        0
      ],
      "expect": {
        "ok": true,
        "rows": {
          "0": {
            "n": 1,
            "months": 1,
            "date": "2026-02-28",
            "clamped": true,
            "notice": null
          },
          "1": {
            "n": 2,
            "months": 2,
            "date": "2026-03-31",
            "clamped": false
          },
          "2": {
            "n": 3,
            "months": 3,
            "date": "2026-04-30",
            "clamped": true
          }
        }
      }
    },
    {
      "name": "更新一覧: 6ヶ月ごと・予告1ヶ月→更新2025-10-15の期限は2025-09-15",
      "func": "renewalDates",
      "args": [
        "2025-04-15",
        6,
        4,
        1
      ],
      "expect": {
        "ok": true,
        "rows": {
          "0": {
            "n": 1,
            "months": 6,
            "date": "2025-10-15",
            "notice": "2025-09-15"
          },
          "3": {
            "n": 4,
            "months": 24,
            "date": "2027-04-15",
            "notice": "2027-03-15"
          }
        }
      }
    },
    {
      "name": "更新一覧: うるう日開始(2024-02-29)の1年後は2025-02-28(調整)",
      "func": "renewalDates",
      "args": [
        "2024-02-29",
        12,
        2,
        0
      ],
      "expect": {
        "ok": true,
        "rows": {
          "0": {
            "n": 1,
            "date": "2025-02-28",
            "clamped": true
          },
          "1": {
            "n": 2,
            "date": "2026-02-28",
            "clamped": true
          }
        }
      }
    },
    {
      "name": "更新一覧: 間隔0ヶ月はエラー",
      "func": "renewalDates",
      "args": [
        "2026-01-01",
        0,
        3,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_interval"
      }
    },
    {
      "name": "更新一覧: 回数49回はエラー(最大48回)",
      "func": "renewalDates",
      "args": [
        "2026-01-01",
        1,
        49,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_count"
      }
    },
    {
      "name": "更新一覧: 不正な日付はエラー",
      "func": "renewalDates",
      "args": [
        "2026-02-30",
        1,
        3,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    }
  ]
}
