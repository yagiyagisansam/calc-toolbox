{
  "tool": "heikin",
  "module": "calc.js",
  "global": "HeikinCalc",
  "cases": [
    {
      "name": "80・90・70: 平均80・中央値80",
      "func": "stats",
      "args": [
        [
          80,
          90,
          70
        ]
      ],
      "expect": {
        "ok": true,
        "n": 3,
        "sum": 240,
        "mean": 80,
        "median": 80,
        "min": 70,
        "max": 90
      }
    },
    {
      "name": "偶数個: 1〜4の中央値は2.5",
      "func": "stats",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expect": {
        "ok": true,
        "mean": 2.5,
        "median": 2.5
      }
    },
    {
      "name": "1個でも計算できる",
      "func": "stats",
      "args": [
        [
          5
        ]
      ],
      "expect": {
        "ok": true,
        "n": 1,
        "mean": 5,
        "median": 5,
        "min": 5,
        "max": 5
      }
    },
    {
      "name": "10・10・20: 平均13.33(外れ値で平均と中央値がずれる例)",
      "func": "stats",
      "args": [
        [
          10,
          10,
          20
        ]
      ],
      "expect": {
        "ok": true,
        "mean": 13.33,
        "median": 10
      }
    },
    {
      "name": "小数もOK: 0.1+0.2の誤差を丸めて処理",
      "func": "stats",
      "args": [
        [
          0.1,
          0.2
        ]
      ],
      "expect": {
        "ok": true,
        "sum": 0.3,
        "mean": 0.15
      }
    },
    {
      "name": "負の数もOK",
      "func": "stats",
      "args": [
        [
          -10,
          10
        ]
      ],
      "expect": {
        "ok": true,
        "mean": 0,
        "median": 0,
        "min": -10,
        "max": 10
      }
    },
    {
      "name": "並び順に関係なく中央値を計算",
      "func": "stats",
      "args": [
        [
          90,
          10,
          50
        ]
      ],
      "expect": {
        "ok": true,
        "median": 50
      }
    },
    {
      "name": "異常入力: 空リストはエラー",
      "func": "stats",
      "args": [
        []
      ],
      "expect": {
        "ok": false,
        "code": "invalid_list"
      }
    },
    {
      "name": "異常入力: 数値以外を含むとエラー",
      "func": "stats",
      "args": [
        [
          1,
          "a",
          3
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "加重平均: 90点(重み2)と70点(重み3)は78",
      "func": "weightedMean",
      "args": [
        [
          [
            90,
            2
          ],
          [
            70,
            3
          ]
        ]
      ],
      "expect": {
        "ok": true,
        "n": 2,
        "weightSum": 5,
        "mean": 78
      }
    },
    {
      "name": "加重平均: 重みが同じなら普通の平均と一致",
      "func": "weightedMean",
      "args": [
        [
          [
            80,
            1
          ],
          [
            60,
            1
          ]
        ]
      ],
      "expect": {
        "ok": true,
        "mean": 70
      }
    },
    {
      "name": "加重平均: 重みの合計が0はエラー",
      "func": "weightedMean",
      "args": [
        [
          [
            90,
            0
          ],
          [
            70,
            0
          ]
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_weight"
      }
    },
    {
      "name": "加重平均: 負の重みはエラー",
      "func": "weightedMean",
      "args": [
        [
          [
            90,
            -1
          ]
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_weight"
      }
    },
    {
      "name": "トリム平均: 10,80,90,100 は最大最小を除いて85",
      "func": "trimmedMean",
      "args": [
        [
          10,
          80,
          90,
          100
        ]
      ],
      "expect": {
        "ok": true,
        "n": 4,
        "used": 2,
        "mean": 85,
        "removedMin": 10,
        "removedMax": 100
      }
    },
    {
      "name": "トリム平均: 3個ちょうどなら真ん中の値",
      "func": "trimmedMean",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expect": {
        "ok": true,
        "used": 1,
        "mean": 2
      }
    },
    {
      "name": "トリム平均: 2個以下はエラー",
      "func": "trimmedMean",
      "args": [
        [
          1,
          2
        ]
      ],
      "expect": {
        "ok": false,
        "code": "too_few"
      }
    },
    {
      "name": "目標平均: 80点70点のあと3回平均80にするには90点",
      "func": "needScore",
      "args": [
        [
          80,
          70
        ],
        80
      ],
      "expect": {
        "ok": true,
        "n": 2,
        "needed": 90,
        "currentMean": 75
      }
    },
    {
      "name": "目標平均: 目標が数値でないのはエラー",
      "func": "needScore",
      "args": [
        [
          80,
          70
        ],
        "x"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_target"
      }
    }
  ]
}
