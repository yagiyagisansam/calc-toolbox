{
  "tool": "jikan",
  "module": "calc.js",
  "global": "JikanCalc",
  "cases": [
    {
      "name": "合計: 1:30+0:45 = 2時間15分(2.25h)",
      "func": "total",
      "args": [
        [
          "1:30",
          "0:45"
        ]
      ],
      "expect": {
        "ok": true,
        "totalMinutes": 135,
        "hours": 2,
        "minutes": 15,
        "decimal": 2.25
      }
    },
    {
      "name": "合計: 1週間分の勤務時間(8:00×5)= 40時間",
      "func": "total",
      "args": [
        [
          "8:00",
          "8:00",
          "8:00",
          "8:00",
          "8:00"
        ]
      ],
      "expect": {
        "ok": true,
        "hours": 40,
        "minutes": 0,
        "decimal": 40
      }
    },
    {
      "name": "時刻の差: 9:00〜17:30 = 8時間30分(8.5h)",
      "func": "span",
      "args": [
        "9:00",
        "17:30"
      ],
      "expect": {
        "ok": true,
        "totalMinutes": 510,
        "hours": 8,
        "minutes": 30,
        "decimal": 8.5
      }
    },
    {
      "name": "日またぎ: 22:00〜6:30 = 8時間30分",
      "func": "span",
      "args": [
        "22:00",
        "6:30"
      ],
      "expect": {
        "ok": true,
        "totalMinutes": 510
      }
    },
    {
      "name": "同時刻は0分",
      "func": "span",
      "args": [
        "9:00",
        "9:00"
      ],
      "expect": {
        "ok": true,
        "totalMinutes": 0
      }
    },
    {
      "name": "10進換算: 1:45 = 1.75時間",
      "func": "total",
      "args": [
        [
          "1:45"
        ]
      ],
      "expect": {
        "ok": true,
        "decimal": 1.75
      }
    },
    {
      "name": "異常入力: 分が60以上はエラー",
      "func": "total",
      "args": [
        [
          "1:75"
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_time"
      }
    },
    {
      "name": "異常入力: 形式不正はエラー",
      "func": "total",
      "args": [
        [
          "90分"
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_time"
      }
    },
    {
      "name": "異常入力: 時刻の差で25時はエラー",
      "func": "span",
      "args": [
        "25:00",
        "9:00"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_start"
      }
    },
    {
      "name": "異常入力: 空リストはエラー",
      "func": "total",
      "args": [
        []
      ],
      "expect": {
        "ok": false,
        "code": "invalid_list"
      }
    },
    {
      "name": "タイムカード: 9時〜18時・休憩60分は実働8時間、時給1200円で9600円",
      "func": "timecard",
      "args": [
        "09:00",
        "18:00",
        60,
        1200
      ],
      "expect": {
        "ok": true,
        "grossMinutes": 540,
        "totalMinutes": 480,
        "hours": 8,
        "minutes": 0,
        "decimal": 8,
        "nightMinutes": 0,
        "pay": 9600
      }
    },
    {
      "name": "タイムカード: 夜勤22時〜翌6時30分・休憩45分は実働7時間45分・深夜帯7時間",
      "func": "timecard",
      "args": [
        "22:00",
        "06:30",
        45,
        1500
      ],
      "expect": {
        "ok": true,
        "grossMinutes": 510,
        "totalMinutes": 465,
        "hours": 7,
        "minutes": 45,
        "decimal": 7.75,
        "nightMinutes": 420,
        "pay": 11625
      }
    },
    {
      "name": "タイムカード: 20時〜23時30分は深夜帯90分、時給なしはpay=null",
      "func": "timecard",
      "args": [
        "20:00",
        "23:30",
        0
      ],
      "expect": {
        "ok": true,
        "grossMinutes": 210,
        "totalMinutes": 210,
        "decimal": 3.5,
        "nightMinutes": 90,
        "pay": null
      }
    },
    {
      "name": "タイムカード: 給与は1円未満を四捨五入(時給1013円×7時間25分=7513円)",
      "func": "timecard",
      "args": [
        "09:00",
        "17:00",
        35,
        1013
      ],
      "expect": {
        "ok": true,
        "totalMinutes": 445,
        "pay": 7513
      }
    },
    {
      "name": "タイムカード: 休憩が勤務時間より長いとエラー",
      "func": "timecard",
      "args": [
        "09:00",
        "10:00",
        120
      ],
      "expect": {
        "ok": false,
        "code": "break_too_long"
      }
    },
    {
      "name": "タイムカード: 24時以降の時刻表記はエラー",
      "func": "timecard",
      "args": [
        "25:00",
        "06:00",
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_start"
      }
    },
    {
      "name": "タイムカード: マイナスの時給はエラー",
      "func": "timecard",
      "args": [
        "09:00",
        "18:00",
        60,
        -100
      ],
      "expect": {
        "ok": false,
        "code": "invalid_wage"
      }
    },
    {
      "name": "10進変換: 7.75時間は7時間45分",
      "func": "dec2hm",
      "args": [
        7.75
      ],
      "expect": {
        "ok": true,
        "totalMinutes": 465,
        "hours": 7,
        "minutes": 45
      }
    },
    {
      "name": "10進変換: 8.334時間は四捨五入で8時間20分",
      "func": "dec2hm",
      "args": [
        8.334
      ],
      "expect": {
        "ok": true,
        "totalMinutes": 500,
        "hours": 8,
        "minutes": 20
      }
    },
    {
      "name": "10進変換: マイナスはエラー",
      "func": "dec2hm",
      "args": [
        -1
      ],
      "expect": {
        "ok": false,
        "code": "invalid_dec"
      }
    }
  ]
}
