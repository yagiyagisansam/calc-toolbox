{
  "tool": "wareki",
  "module": "calc.js",
  "global": "WarekiCalc",
  "cases": [
    {
      "name": "2026年 → 令和8年",
      "func": "toWareki",
      "args": [
        2026
      ],
      "expect": {
        "ok": true,
        "results": [
          {
            "era": "令和",
            "eraYear": 8,
            "label": "令和8年"
          }
        ]
      }
    },
    {
      "name": "改元年2019年 → 平成31年と令和元年の両方",
      "func": "toWareki",
      "args": [
        2019
      ],
      "expect": {
        "ok": true,
        "results": [
          {
            "era": "平成",
            "eraYear": 31,
            "label": "平成31年"
          },
          {
            "era": "令和",
            "eraYear": 1,
            "label": "令和元年"
          }
        ]
      }
    },
    {
      "name": "改元年1989年 → 昭和64年と平成元年の両方",
      "func": "toWareki",
      "args": [
        1989
      ],
      "expect": {
        "ok": true,
        "results": [
          {
            "era": "昭和",
            "eraYear": 64,
            "label": "昭和64年"
          },
          {
            "era": "平成",
            "eraYear": 1,
            "label": "平成元年"
          }
        ]
      }
    },
    {
      "name": "改元年1912年 → 明治45年と大正元年の両方",
      "func": "toWareki",
      "args": [
        1912
      ],
      "expect": {
        "ok": true,
        "results": [
          {
            "era": "明治",
            "eraYear": 45,
            "label": "明治45年"
          },
          {
            "era": "大正",
            "eraYear": 1,
            "label": "大正元年"
          }
        ]
      }
    },
    {
      "name": "改元年1926年 → 大正15年と昭和元年の両方",
      "func": "toWareki",
      "args": [
        1926
      ],
      "expect": {
        "ok": true,
        "results": [
          {
            "era": "大正",
            "eraYear": 15,
            "label": "大正15年"
          },
          {
            "era": "昭和",
            "eraYear": 1,
            "label": "昭和元年"
          }
        ]
      }
    },
    {
      "name": "1950年 → 昭和25年",
      "func": "toWareki",
      "args": [
        1950
      ],
      "expect": {
        "ok": true,
        "results": [
          {
            "era": "昭和",
            "eraYear": 25,
            "label": "昭和25年"
          }
        ]
      }
    },
    {
      "name": "2000年 → 平成12年",
      "func": "toWareki",
      "args": [
        2000
      ],
      "expect": {
        "ok": true,
        "results": [
          {
            "era": "平成",
            "eraYear": 12,
            "label": "平成12年"
          }
        ]
      }
    },
    {
      "name": "和暦→西暦: 令和8年 → 2026年",
      "func": "toSeireki",
      "args": [
        "令和",
        8
      ],
      "expect": {
        "ok": true,
        "year": 2026
      }
    },
    {
      "name": "和暦→西暦: 昭和64年 → 1989年",
      "func": "toSeireki",
      "args": [
        "昭和",
        64
      ],
      "expect": {
        "ok": true,
        "year": 1989
      }
    },
    {
      "name": "和暦→西暦: 平成31年 → 2019年",
      "func": "toSeireki",
      "args": [
        "平成",
        31
      ],
      "expect": {
        "ok": true,
        "year": 2019
      }
    },
    {
      "name": "和暦→西暦: 明治元年 → 1868年",
      "func": "toSeireki",
      "args": [
        "明治",
        1
      ],
      "expect": {
        "ok": true,
        "year": 1868
      }
    },
    {
      "name": "異常入力: 1867年(明治以前)はエラー",
      "func": "toWareki",
      "args": [
        1867
      ],
      "expect": {
        "ok": false,
        "code": "invalid_year"
      }
    },
    {
      "name": "異常入力: 小数の年はエラー",
      "func": "toWareki",
      "args": [
        2020.5
      ],
      "expect": {
        "ok": false,
        "code": "invalid_year"
      }
    },
    {
      "name": "異常入力: 存在しない元号はエラー",
      "func": "toSeireki",
      "args": [
        "慶応",
        3
      ],
      "expect": {
        "ok": false,
        "code": "invalid_era"
      }
    },
    {
      "name": "異常入力: 明治46年(範囲外)はエラー",
      "func": "toSeireki",
      "args": [
        "明治",
        46
      ],
      "expect": {
        "ok": false,
        "code": "invalid_era_year"
      }
    },
    {
      "name": "異常入力: 和暦0年はエラー",
      "func": "toSeireki",
      "args": [
        "令和",
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_era_year"
      }
    },
    {
      "name": "年度: 2026年3月は2025年度(令和7年度)",
      "func": "fiscalYear",
      "args": [
        2026,
        3
      ],
      "expect": {
        "ok": true,
        "fiscalYear": 2025,
        "labels": {
          "0": "令和7年度",
          "length": 1
        }
      }
    },
    {
      "name": "年度: 2026年4月は2026年度(令和8年度)",
      "func": "fiscalYear",
      "args": [
        2026,
        4
      ],
      "expect": {
        "ok": true,
        "fiscalYear": 2026,
        "labels": {
          "0": "令和8年度"
        }
      }
    },
    {
      "name": "年度: 改元年の2019年5月は平成31年度・令和元年度の両方",
      "func": "fiscalYear",
      "args": [
        2019,
        5
      ],
      "expect": {
        "ok": true,
        "fiscalYear": 2019,
        "labels": {
          "0": "平成31年度",
          "1": "令和元年度",
          "length": 2
        }
      }
    },
    {
      "name": "年度: 1868年2月は1867年度になるため範囲外エラー",
      "func": "fiscalYear",
      "args": [
        1868,
        2
      ],
      "expect": {
        "ok": false,
        "code": "out_of_range"
      }
    },
    {
      "name": "年度: 月が0はエラー",
      "func": "fiscalYear",
      "args": [
        2026,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_month"
      }
    },
    {
      "name": "満年齢: 1980年生まれは2026年の誕生日で46歳",
      "func": "ageThisYear",
      "args": [
        1980,
        2026
      ],
      "expect": {
        "ok": true,
        "age": 46
      }
    },
    {
      "name": "満年齢: 生まれた年と同じ年は0歳",
      "func": "ageThisYear",
      "args": [
        2026,
        2026
      ],
      "expect": {
        "ok": true,
        "age": 0
      }
    },
    {
      "name": "満年齢: 生まれ年が基準年より後ならエラー",
      "func": "ageThisYear",
      "args": [
        2027,
        2026
      ],
      "expect": {
        "ok": false,
        "code": "invalid_order"
      }
    },
    {
      "name": "正確変換: 1989年1月7日は昭和64年",
      "func": "toWarekiExact",
      "args": [
        1989,
        1,
        7
      ],
      "expect": {
        "ok": true,
        "era": "昭和",
        "eraYear": 64
      }
    },
    {
      "name": "正確変換: 1989年1月8日は平成元年",
      "func": "toWarekiExact",
      "args": [
        1989,
        1,
        8
      ],
      "expect": {
        "ok": true,
        "era": "平成",
        "eraYear": 1,
        "label": "平成元年"
      }
    },
    {
      "name": "正確変換: 2019年4月30日は平成31年",
      "func": "toWarekiExact",
      "args": [
        2019,
        4,
        30
      ],
      "expect": {
        "ok": true,
        "era": "平成",
        "eraYear": 31
      }
    },
    {
      "name": "正確変換: 2019年5月1日は令和元年",
      "func": "toWarekiExact",
      "args": [
        2019,
        5,
        1
      ],
      "expect": {
        "ok": true,
        "era": "令和",
        "eraYear": 1
      }
    },
    {
      "name": "正確変換: 2月30日など実在しない日付はエラー",
      "func": "toWarekiExact",
      "args": [
        2026,
        2,
        30
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    },
    {
      "name": "満年齢: 1980年6月15日生まれは2026年6月14日時点で満45歳",
      "func": "ageOn",
      "args": [
        1980,
        6,
        15,
        2026,
        6,
        14
      ],
      "expect": {
        "ok": true,
        "age": 45
      }
    },
    {
      "name": "満年齢: 誕生日当日に1歳加算(2026年6月15日で満46歳)",
      "func": "ageOn",
      "args": [
        1980,
        6,
        15,
        2026,
        6,
        15
      ],
      "expect": {
        "ok": true,
        "age": 46
      }
    },
    {
      "name": "満年齢: 基準日が誕生日より前はエラー",
      "func": "ageOn",
      "args": [
        2030,
        1,
        1,
        2026,
        1,
        1
      ],
      "expect": {
        "ok": false,
        "code": "invalid_order"
      }
    }
  ]
}
