{
  "tool": "protein",
  "module": "calc.js",
  "global": "ProteinCalc",
  "cases": [
    {
      "name": "60kg・ふつうの生活: 54g/日",
      "func": "needs",
      "args": [
        60,
        "normal"
      ],
      "expect": {
        "ok": true,
        "grams": 54,
        "rate": 0.9
      }
    },
    {
      "name": "70kg・筋トレ: 112g/日",
      "func": "needs",
      "args": [
        70,
        "training"
      ],
      "expect": {
        "ok": true,
        "grams": 112,
        "rate": 1.6
      }
    },
    {
      "name": "50kg・運動習慣あり: 60g/日",
      "func": "needs",
      "args": [
        50,
        "active"
      ],
      "expect": {
        "ok": true,
        "grams": 60,
        "rate": 1.2
      }
    },
    {
      "name": "80kg・ふつう: 72g/日",
      "func": "needs",
      "args": [
        80,
        "normal"
      ],
      "expect": {
        "ok": true,
        "grams": 72
      }
    },
    {
      "name": "ラベルも返す",
      "func": "needs",
      "args": [
        60,
        "active"
      ],
      "expect": {
        "ok": true,
        "label": "運動習慣あり(週2〜3回)"
      }
    },
    {
      "name": "異常入力: 体重20kg未満はエラー",
      "func": "needs",
      "args": [
        10,
        "normal"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_weight"
      }
    },
    {
      "name": "異常入力: 体重301kg以上はエラー",
      "func": "needs",
      "args": [
        301,
        "normal"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_weight"
      }
    },
    {
      "name": "異常入力: 不正なレベルはエラー",
      "func": "needs",
      "args": [
        60,
        "athlete2"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_level"
      }
    },
    {
      "name": "食品換算: 66gは鶏むね300g・卵11個・納豆8.3パック・牛乳9.4杯・プロテイン3.3杯",
      "func": "foodEquivalents",
      "args": [
        66
      ],
      "expect": {
        "ok": true,
        "chickenG": 300,
        "eggs": 11,
        "natto": 8.3,
        "milkCups": 9.4,
        "scoops": 3.3
      }
    },
    {
      "name": "食品換算: 100gは鶏むね455g・卵16.7個・プロテイン5杯",
      "func": "foodEquivalents",
      "args": [
        100
      ],
      "expect": {
        "ok": true,
        "chickenG": 455,
        "eggs": 16.7,
        "natto": 12.5,
        "milkCups": 14.3,
        "scoops": 5
      }
    },
    {
      "name": "食品換算: 0gはエラー",
      "func": "foodEquivalents",
      "args": [
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_grams"
      }
    },
    {
      "name": "摂取量合計: 鶏むね200g+卵2個+納豆1+牛乳200mlは71g",
      "func": "intakeFromFoods",
      "args": [
        {
          "chickenG": 200,
          "eggs": 2,
          "natto": 1,
          "milkMl": 200
        }
      ],
      "expect": {
        "ok": true,
        "totalG": 71
      }
    },
    {
      "name": "摂取量合計: プロテイン2杯のみは40g",
      "func": "intakeFromFoods",
      "args": [
        {
          "scoops": 2
        }
      ],
      "expect": {
        "ok": true,
        "totalG": 40
      }
    },
    {
      "name": "摂取量合計: すべて未入力はエラー",
      "func": "intakeFromFoods",
      "args": [
        {}
      ],
      "expect": {
        "ok": false,
        "code": "invalid_foods"
      }
    },
    {
      "name": "摂取量合計: 卵40個は範囲外エラー",
      "func": "intakeFromFoods",
      "args": [
        {
          "eggs": 40
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalid_amount"
      }
    }
  ]
}
