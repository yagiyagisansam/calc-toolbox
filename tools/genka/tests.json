{
  "tool": "genka",
  "module": "calc.js",
  "global": "GenkaCalc",
  "cases": [
    {
      "name": "売価1,000円・原価600円: 粗利400円・利益率40%・原価率60%",
      "func": "analyze",
      "args": [
        1000,
        600
      ],
      "expect": {
        "ok": true,
        "profit": 400,
        "marginPct": 40,
        "costPct": 60
      }
    },
    {
      "name": "飲食の例: 売価800円・原価240円 → 原価率30%",
      "func": "analyze",
      "args": [
        800,
        240
      ],
      "expect": {
        "ok": true,
        "costPct": 30,
        "marginPct": 70
      }
    },
    {
      "name": "赤字も計算できる(売価500円・原価650円 → 利益率-30%)",
      "func": "analyze",
      "args": [
        500,
        650
      ],
      "expect": {
        "ok": true,
        "profit": -150,
        "marginPct": -30
      }
    },
    {
      "name": "原価0円なら利益率100%",
      "func": "analyze",
      "args": [
        1000,
        0
      ],
      "expect": {
        "ok": true,
        "marginPct": 100,
        "costPct": 0
      }
    },
    {
      "name": "逆算: 原価600円で利益率40%にしたい → 売価1,000円",
      "func": "priceFor",
      "args": [
        600,
        40
      ],
      "expect": {
        "ok": true,
        "price": 1000
      }
    },
    {
      "name": "逆算: 原価700円・利益率30% → 売価1,000円",
      "func": "priceFor",
      "args": [
        700,
        30
      ],
      "expect": {
        "ok": true,
        "price": 1000
      }
    },
    {
      "name": "逆算: 利益率0%なら売価=原価",
      "func": "priceFor",
      "args": [
        500,
        0
      ],
      "expect": {
        "ok": true,
        "price": 500
      }
    },
    {
      "name": "異常入力: 売価0はエラー",
      "func": "analyze",
      "args": [
        0,
        100
      ],
      "expect": {
        "ok": false,
        "code": "invalid_price"
      }
    },
    {
      "name": "異常入力: 原価が負はエラー",
      "func": "analyze",
      "args": [
        1000,
        -1
      ],
      "expect": {
        "ok": false,
        "code": "invalid_cost"
      }
    },
    {
      "name": "異常入力: 目標利益率100%はエラー",
      "func": "priceFor",
      "args": [
        600,
        100
      ],
      "expect": {
        "ok": false,
        "code": "invalid_margin"
      }
    },
    {
      "name": "損益分岐: 固定費10万・変動費300円・単価800円は200個(売上16万円)",
      "func": "breakEven",
      "args": [
        100000,
        300,
        800
      ],
      "expect": {
        "ok": true,
        "qty": 200,
        "sales": 160000,
        "unitMargin": 500,
        "marginRatePct": 62.5
      }
    },
    {
      "name": "損益分岐: 割り切れない場合は切り上げ(固定費10万・変動費250円・単価600円→286個)",
      "func": "breakEven",
      "args": [
        100000,
        250,
        600
      ],
      "expect": {
        "ok": true,
        "qty": 286,
        "sales": 171600,
        "unitMargin": 350
      }
    },
    {
      "name": "損益分岐: 目標利益5万円を足すと300個",
      "func": "breakEven",
      "args": [
        100000,
        300,
        800,
        50000
      ],
      "expect": {
        "ok": true,
        "qty": 300,
        "sales": 240000
      }
    },
    {
      "name": "損益分岐: 単価が変動費以下はエラー(何個売っても黒字にならない)",
      "func": "breakEven",
      "args": [
        100000,
        800,
        800
      ],
      "expect": {
        "ok": false,
        "code": "no_margin"
      }
    },
    {
      "name": "手取り: 3000円売り・手数料10%・送料210円・原価1000円は手取り1,490円",
      "func": "netProfit",
      "args": [
        3000,
        10,
        210,
        1000
      ],
      "expect": {
        "ok": true,
        "fee": 300,
        "profit": 1490,
        "marginPct": 49.7
      }
    },
    {
      "name": "手取り: 送料が高いと赤字になる(1000円売り・手数料10%・送料750円・原価500円)",
      "func": "netProfit",
      "args": [
        1000,
        10,
        750,
        500
      ],
      "expect": {
        "ok": true,
        "fee": 100,
        "profit": -350,
        "marginPct": -35
      }
    }
  ]
}
