      "expect": {
        "ok": false,
        "code": "invalid_per"
      }
    },
    {
      "name": "異常入力: 6商品はエラー(上限5)",
      "func": "compare",
      "args": [
        [
          {
            "price": 1,
            "qty": 1
          },
          {
            "price": 1,
            "qty": 1
          },
          {
            "price": 1,
            "qty": 1
          },
          {
            "price": 1,
            "qty": 1
          },
          {
            "price": 1,
            "qty": 1
          },
          {
            "price": 1,
            "qty": 1
          }
        ],
        100
      ],
      "expect": {
        "ok": false,
        "code": "invalid_items"
      }
    },
    {
      "name": "送料込み比較: 本体が安くても送料で逆転(1000円送料0 vs 900円送料200)",
      "func": "compareWithShipping",
      "args": [
        [
          {
            "price": 1000,
            "qty": 500,
            "ship": 0
          },
          {
            "price": 900,
            "qty": 500,
            "ship": 200
          }
        ],
        100
      ],
      "expect": {
        "ok": true,
        "cheapest": 0,
        "rows": [
          {
            "unitPrice": 200,
            "diffPct": 0,
            "total": 1000
          },
          {
            "unitPrice": 220,
            "diffPct": 10,
            "total": 1100
          }
        ]
      }
    },
    {
      "name": "送料込み比較: 送料を省略した商品は0円扱い",
      "func": "compareWithShipping",
      "args": [
        [
          {
            "price": 300,
            "qty": 3
          },
          {
            "price": 500,
            "qty": 6,
            "ship": 100
          }
        ],
        1
      ],
      "expect": {
        "ok": true,
        "cheapest": 0,
        "rows": [
          {
            "unitPrice": 100,
            "diffPct": 0
          },
          {
            "unitPrice": 100,
            "diffPct": 0
          }
        ]
      }
    },
    {
      "name": "送料込み比較: 送料がマイナスはエラー",
      "func": "compareWithShipping",
      "args": [
        [
          {
            "price": 1000,
            "qty": 500,
            "ship": -10
          },
          {
            "price": 900,
            "qty": 500,
            "ship": 0
          }
        ],
        100
      ],
      "expect": {
        "ok": false,
        "code": "invalid_item"
      }
    },
    {
      "name": "送料無料判定: 不足500円・送料600円なら買い足しが得",
      "func": "freeShipCheck",
      "args": [
        4500,
        5000,
        600
      ],
      "expect": {
        "ok": true,
        "shortfall": 500,
        "free": false,
        "worth": true
      }
    },
    {
      "name": "送料無料判定: すでにライン超えなら不足0円",
      "func": "freeShipCheck",
      "args": [
        5200,
        5000,
        600
      ],
      "expect": {
        "ok": true,
        "shortfall": 0,
        "free": true,
        "worth": false
      }
    },
    {
      "name": "送料無料判定: 不足2000円・送料600円なら送料を払う方が安い",
      "func": "freeShipCheck",
      "args": [
        3000,
        5000,
        600
      ],
      "expect": {
        "ok": true,
        "shortfall": 2000,
        "free": false,
        "worth": false
      }
    }
  ]
}
