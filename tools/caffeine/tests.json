{
  "tool": "caffeine",
  "module": "calc.js",
  "global": "CaffeineCalc",
  "cases": [
    {
      "name": "コーヒー1杯(200ml): 120mg・成人目安の30%",
      "func": "total",
      "args": [
        [
          {
            "drink": "coffee",
            "ml": 200
          }
        ]
      ],
      "expect": {
        "ok": true,
        "totalMg": 120,
        "pctAdult": 30,
        "pctPregnant": 60
      }
    },
    {
      "name": "コーヒー200ml+紅茶300ml: 210mg・53%",
      "func": "total",
      "args": [
        [
          {
            "drink": "coffee",
            "ml": 200
          },
          {
            "drink": "blacktea",
            "ml": 300
          }
        ]
      ],
      "expect": {
        "ok": true,
        "totalMg": 210,
        "pctAdult": 53
      }
    },
    {
      "name": "コーヒー3杯+エナドリ1本: 500mg超で100%超え",
      "func": "total",
      "args": [
        [
          {
            "drink": "coffee",
            "ml": 600
          },
          {
            "drink": "energy",
            "ml": 500
          }
        ]
      ],
      "expect": {
        "ok": true,
        "totalMg": 520,
        "pctAdult": 130
      }
    },
    {
      "name": "玉露は高濃度(100mlで160mg)",
      "func": "total",
      "args": [
        [
          {
            "drink": "gyokuro",
            "ml": 100
          }
        ]
      ],
      "expect": {
        "ok": true,
        "totalMg": 160
      }
    },
    {
      "name": "緑茶500mlペットボトル: 100mg",
      "func": "total",
      "args": [
        [
          {
            "drink": "sencha",
            "ml": 500
          }
        ]
      ],
      "expect": {
        "ok": true,
        "totalMg": 100,
        "pctAdult": 25
      }
    },
    {
      "name": "カフェインレスはごく少量",
      "func": "total",
      "args": [
        [
          {
            "drink": "decaf",
            "ml": 200
          }
        ]
      ],
      "expect": {
        "ok": true,
        "totalMg": 2
      }
    },
    {
      "name": "異常入力: 空リストはエラー",
      "func": "total",
      "args": [
        []
      ],
      "expect": {
        "ok": false,
        "code": "invalid_items"
      }
    },
    {
      "name": "異常入力: 不正な飲み物はエラー",
      "func": "total",
      "args": [
        [
          {
            "drink": "beer",
            "ml": 350
          }
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_drink"
      }
    },
    {
      "name": "異常入力: 量0はエラー",
      "func": "total",
      "args": [
        [
          {
            "drink": "coffee",
            "ml": 0
          }
        ]
      ],
      "expect": {
        "ok": false,
        "code": "invalid_ml"
      }
    },
    {
      "name": "残留量: 18時に2杯・23時就寝は半減期1回分で90mg(影響小)",
      "func": "remainingAtBed",
      "args": [
        "18:00",
        "23:00",
        2
      ],
      "expect": {
        "ok": true,
        "intakeMg": 180,
        "hoursUntilBed": 5,
        "remainingMg": 90,
        "affectSleep": false
      }
    },
    {
      "name": "残留量: 20時に2杯・23時就寝は119mgで影響しやすい",
      "func": "remainingAtBed",
      "args": [
        "20:00",
        "23:00",
        2
      ],
      "expect": {
        "ok": true,
        "intakeMg": 180,
        "hoursUntilBed": 3,
        "remainingMg": 119,
        "affectSleep": true
      }
    },
    {
      "name": "残留量: 日をまたぐ(22時に1杯・翌6時就寝)は8時間後で30mg",
      "func": "remainingAtBed",
      "args": [
        "22:00",
        "06:00",
        1
      ],
      "expect": {
        "ok": true,
        "intakeMg": 90,
        "hoursUntilBed": 8,
        "remainingMg": 30,
        "affectSleep": false
      }
    },
    {
      "name": "残留量: 不正な時刻(25:00)はエラー",
      "func": "remainingAtBed",
      "args": [
        "25:00",
        "23:00",
        1
      ],
      "expect": {
        "ok": false,
        "code": "invalid_drink_time"
      }
    },
    {
      "name": "残留量: 杯数0はエラー",
      "func": "remainingAtBed",
      "args": [
        "18:00",
        "23:00",
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_cups"
      }
    },
    {
      "name": "最後の1杯: 23時就寝で2杯(180mg)は約4.2時間前=18:46まで",
      "func": "lastCupTime",
      "args": [
        "23:00",
        2
      ],
      "expect": {
        "ok": true,
        "anytime": false,
        "intakeMg": 180,
        "hoursBefore": 4.2,
        "latestTime": "18:46"
      }
    },
    {
      "name": "最後の1杯: 1杯(90mg)は最初から100mg未満なので制限なし",
      "func": "lastCupTime",
      "args": [
        "23:00",
        1
      ],
      "expect": {
        "ok": true,
        "anytime": true,
        "intakeMg": 90
      }
    },
    {
      "name": "最後の1杯: 杯数11はエラー",
      "func": "lastCupTime",
      "args": [
        "23:00",
        11
      ],
      "expect": {
        "ok": false,
        "code": "invalid_cups"
      }
    }
  ]
}
