{
  "tool": "shinpaku",
  "module": "calc.js",
  "global": "ShinpakuCalc",
  "cases": [
    {
      "name": "40歳・安静時70: 最大180・50%=125・70%=147",
      "func": "zones",
      "args": [
        40,
        70
      ],
      "expect": {
        "ok": true,
        "maxHr": 180,
        "reserve": 110,
        "z40": 114,
        "z50": 125,
        "z60": 136,
        "z70": 147
      }
    },
    {
      "name": "60歳・安静時60: 最大160・50%=110・70%=130",
      "func": "zones",
      "args": [
        60,
        60
      ],
      "expect": {
        "ok": true,
        "maxHr": 160,
        "z40": 100,
        "z50": 110,
        "z60": 120,
        "z70": 130
      }
    },
    {
      "name": "20歳・安静時65",
      "func": "zones",
      "args": [
        20,
        65
      ],
      "expect": {
        "ok": true,
        "maxHr": 200,
        "reserve": 135,
        "z50": 133
      }
    },
    {
      "name": "安静時心拍が高い人はゾーンも上がる",
      "func": "zones",
      "args": [
        40,
        80
      ],
      "expect": {
        "ok": true,
        "z50": 130
      }
    },
    {
      "name": "異常入力: 14歳以下はエラー",
      "func": "zones",
      "args": [
        14,
        70
      ],
      "expect": {
        "ok": false,
        "code": "invalid_age"
      }
    },
    {
      "name": "異常入力: 101歳以上はエラー",
      "func": "zones",
      "args": [
        101,
        70
      ],
      "expect": {
        "ok": false,
        "code": "invalid_age"
      }
    },
    {
      "name": "異常入力: 安静時心拍29以下はエラー",
      "func": "zones",
      "args": [
        40,
        29
      ],
      "expect": {
        "ok": false,
        "code": "invalid_rest"
      }
    },
    {
      "name": "異常入力: 安静時心拍121以上はエラー",
      "func": "zones",
      "args": [
        40,
        121
      ],
      "expect": {
        "ok": false,
        "code": "invalid_rest"
      }
    },
    {
      "name": "5ゾーン: 40歳は最大180、ゾーン1は90〜108",
      "func": "fiveZones",
      "args": [
        40
      ],
      "expect": {
        "ok": true,
        "maxHr": 180,
        "zones": {
          "0": {
            "no": 1,
            "label": "回復(とても楽)",
            "pct": "50〜60%",
            "lo": 90,
            "hi": 108
          },
          "1": {
            "no": 2,
            "label": "脂肪燃焼(楽)",
            "pct": "60〜70%",
            "lo": 108,
            "hi": 126
          },
          "2": {
            "no": 3,
            "label": "持久力(ややきつい)",
            "pct": "70〜80%",
            "lo": 126,
            "hi": 144
          },
          "3": {
            "no": 4,
            "label": "乳酸性作業閾値(きつい)",
            "pct": "80〜90%",
            "lo": 144,
            "hi": 162
          },
          "4": {
            "no": 5,
            "label": "最大強度(非常にきつい)",
            "pct": "90〜100%",
            "lo": 162,
            "hi": 180
          },
          "length": 5
        }
      }
    },
    {
      "name": "5ゾーン: 25歳は最大195、四捨五入の境界を確認",
      "func": "fiveZones",
      "args": [
        25
      ],
      "expect": {
        "ok": true,
        "maxHr": 195,
        "zones": {
          "0": {
            "lo": 98,
            "hi": 117
          },
          "4": {
            "lo": 176,
            "hi": 195
          }
        }
      }
    },
    {
      "name": "5ゾーン: 14歳以下はエラー",
      "func": "fiveZones",
      "args": [
        14
      ],
      "expect": {
        "ok": false,
        "code": "invalid_age"
      }
    },
    {
      "name": "脈拍チェック: 40歳・安静70・10秒21拍は126拍/分=強度51%",
      "func": "pulseCheck",
      "args": [
        40,
        70,
        21
      ],
      "expect": {
        "ok": true,
        "bpm": 126,
        "pct": 51,
        "label": "健康づくり・脂肪燃焼の強度"
      }
    },
    {
      "name": "脈拍チェック: 40歳・安静70・10秒30拍は180拍/分=強度100%",
      "func": "pulseCheck",
      "args": [
        40,
        70,
        30
      ],
      "expect": {
        "ok": true,
        "bpm": 180,
        "pct": 100,
        "label": "ほぼ全力(長くは続けられない強度)"
      }
    },
    {
      "name": "脈拍チェック: 安静時より低い脈拍は強度0%に切り上げ",
      "func": "pulseCheck",
      "args": [
        40,
        70,
        10
      ],
      "expect": {
        "ok": true,
        "bpm": 60,
        "pct": 0,
        "label": "楽(準備運動の範囲)"
      }
    },
    {
      "name": "脈拍チェック: 10秒4拍以下はエラー",
      "func": "pulseCheck",
      "args": [
        40,
        70,
        4
      ],
      "expect": {
        "ok": false,
        "code": "invalid_pulse"
      }
    }
  ]
}
