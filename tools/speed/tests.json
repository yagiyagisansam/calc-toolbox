{
  "tool": "speed",
  "module": "calc.js",
  "global": "SpeedCalc",
  "cases": [
    {
      "name": "80km/h・150km → 112.5分(1時間53分)",
      "func": "solve",
      "args": [
        {
          "speedKmh": 80,
          "distanceKm": 150
        }
      ],
      "expect": {
        "ok": true,
        "timeMin": 112.5,
        "timeH": 1,
        "timeM": 53
      }
    },
    {
      "name": "フルマラソン42.195kmを4時間 → 平均10.55km/h",
      "func": "solve",
      "args": [
        {
          "distanceKm": 42.195,
          "timeMin": 240
        }
      ],
      "expect": {
        "ok": true,
        "speedKmh": 10.55
      }
    },
    {
      "name": "60km/hで4.5時間(270分)→ 270km",
      "func": "solve",
      "args": [
        {
          "speedKmh": 60,
          "timeMin": 270
        }
      ],
      "expect": {
        "ok": true,
        "distanceKm": 270
      }
    },
    {
      "name": "徒歩4km/hで2km → 30分",
      "func": "solve",
      "args": [
        {
          "speedKmh": 4,
          "distanceKm": 2
        }
      ],
      "expect": {
        "ok": true,
        "timeMin": 30,
        "timeH": 0,
        "timeM": 30
      }
    },
    {
      "name": "新幹線285km/hで515km → 約108.42分",
      "func": "solve",
      "args": [
        {
          "speedKmh": 285,
          "distanceKm": 515
        }
      ],
      "expect": {
        "ok": true,
        "timeMin": 108.42,
        "timeH": 1,
        "timeM": 48
      }
    },
    {
      "name": "異常入力: 1つだけの指定はエラー",
      "func": "solve",
      "args": [
        {
          "speedKmh": 80
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalid_input"
      }
    },
    {
      "name": "異常入力: 3つ全部の指定はエラー",
      "func": "solve",
      "args": [
        {
          "speedKmh": 80,
          "distanceKm": 100,
          "timeMin": 60
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalid_input"
      }
    },
    {
      "name": "異常入力: 速さ0はエラー",
      "func": "solve",
      "args": [
        {
          "speedKmh": 0,
          "distanceKm": 100
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "異常入力: 負の距離はエラー",
      "func": "solve",
      "args": [
        {
          "speedKmh": 80,
          "distanceKm": -5
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "到着: 9:00発・150km・80km/h・休憩20分→11:13着(移動113分)",
      "func": "arrival",
      "args": [
        9,
        0,
        150,
        80,
        20
      ],
      "expect": {
        "ok": true,
        "arriveH": 11,
        "arriveM": 13,
        "daysLater": 0,
        "travelMin": 113,
        "totalMin": 133
      }
    },
    {
      "name": "到着: 23:30発・60km・40km/h→翌日1:00着",
      "func": "arrival",
      "args": [
        23,
        30,
        60,
        40,
        0
      ],
      "expect": {
        "ok": true,
        "arriveH": 1,
        "arriveM": 0,
        "daysLater": 1,
        "travelMin": 90
      }
    },
    {
      "name": "到着: 時刻が範囲外(25時)はエラー",
      "func": "arrival",
      "args": [
        25,
        0,
        100,
        50,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_time"
      }
    },
    {
      "name": "到着: 速さ0はエラー",
      "func": "arrival",
      "args": [
        9,
        0,
        100,
        0,
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    },
    {
      "name": "逆算: 12:00着・150km・80km/h・休憩20分→9:47発",
      "func": "departure",
      "args": [
        12,
        0,
        150,
        80,
        20
      ],
      "expect": {
        "ok": true,
        "depH": 9,
        "depM": 47,
        "prevDay": false,
        "totalMin": 133
      }
    },
    {
      "name": "逆算: 0:30着・移動90分→前日23:00発",
      "func": "departure",
      "args": [
        0,
        30,
        60,
        40,
        0
      ],
      "expect": {
        "ok": true,
        "depH": 23,
        "depM": 0,
        "prevDay": true,
        "travelMin": 90
      }
    },
    {
      "name": "単位: 時速60km=分速1000m・秒速16.67m",
      "func": "speedUnits",
      "args": [
        60
      ],
      "expect": {
        "ok": true,
        "mPerMin": 1000,
        "mPerSec": 16.67
      }
    },
    {
      "name": "単位: 時速36km=秒速10m",
      "func": "speedUnits",
      "args": [
        36
      ],
      "expect": {
        "ok": true,
        "mPerMin": 600,
        "mPerSec": 10
      }
    },
    {
      "name": "単位: 0以下はエラー",
      "func": "speedUnits",
      "args": [
        0
      ],
      "expect": {
        "ok": false,
        "code": "invalid_value"
      }
    }
  ]
}
