{
  "tool": "rireki",
  "module": "calc.js",
  "global": "RirekiCalc",
  "cases": [
    {
      "name": "1990-07-18生まれ: 小学校1997年入学・高校2009年卒・大学2013年卒",
      "func": "schoolYears",
      "args": [
        "1990-07-18"
      ],
      "expect": {
        "ok": true,
        "hayaumare": false,
        "elemIn": 1997,
        "elemOut": 2003,
        "jhsOut": 2006,
        "hsOut": 2009,
        "uniIn": 2009,
        "uniOut": 2013
      }
    },
    {
      "name": "早生まれ1991-02-15: 1990年生まれの遅生まれと同学年(1997年入学)",
      "func": "schoolYears",
      "args": [
        "1991-02-15"
      ],
      "expect": {
        "ok": true,
        "hayaumare": true,
        "elemIn": 1997
      }
    },
    {
      "name": "4月1日生まれは早生まれ(2000-04-01 → 2006年入学)",
      "func": "schoolYears",
      "args": [
        "2000-04-01"
      ],
      "expect": {
        "ok": true,
        "hayaumare": true,
        "elemIn": 2006
      }
    },
    {
      "name": "4月2日生まれは遅生まれ(2000-04-02 → 2007年入学)",
      "func": "schoolYears",
      "args": [
        "2000-04-02"
      ],
      "expect": {
        "ok": true,
        "hayaumare": false,
        "elemIn": 2007
      }
    },
    {
      "name": "中学・高校の入卒が連続する(2007入学→中2013-2016→高2016-2019)",
      "func": "schoolYears",
      "args": [
        "2000-04-02"
      ],
      "expect": {
        "ok": true,
        "jhsIn": 2013,
        "jhsOut": 2016,
        "hsIn": 2016,
        "hsOut": 2019,
        "uniOut": 2023
      }
    },
    {
      "name": "和暦変換: 2019年 → 令和元年",
      "func": "wareki",
      "args": [
        2019
      ],
      "expect": "令和元年"
    },
    {
      "name": "和暦変換: 1997年 → 平成9年",
      "func": "wareki",
      "args": [
        1997
      ],
      "expect": "平成9年"
    },
    {
      "name": "和暦変換: 1985年 → 昭和60年",
      "func": "wareki",
      "args": [
        1985
      ],
      "expect": "昭和60年"
    },
    {
      "name": "異常入力: 存在しない日付はエラー",
      "func": "schoolYears",
      "args": [
        "2000-02-30"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    },
    {
      "name": "異常入力: 形式不正はエラー",
      "func": "schoolYears",
      "args": [
        "2000/04/01"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    },
    {
      "name": "補正: 1990-05-15生まれ・1浪・休学1年→大学2010年入学・2015年卒業",
      "func": "detailedYears",
      "args": [
        "1990-05-15",
        1,
        0,
        1,
        "none"
      ],
      "expect": {
        "ok": true,
        "hayaumare": false,
        "elemIn": 1997,
        "hsOut": 2009,
        "uniIn": 2010,
        "uniOut": 2015,
        "msIn": null,
        "drIn": null
      }
    },
    {
      "name": "補正: 2000-02-10生まれ(早生まれ)・現役→大学2018年入学・2022年卒業",
      "func": "detailedYears",
      "args": [
        "2000-02-10",
        0,
        0,
        0,
        "none"
      ],
      "expect": {
        "ok": true,
        "hayaumare": true,
        "elemIn": 2006,
        "uniIn": 2018,
        "uniOut": 2022
      }
    },
    {
      "name": "補正: 博士まで進学→修士2022〜2024・博士2024〜2027",
      "func": "detailedYears",
      "args": [
        "2000-02-10",
        0,
        0,
        0,
        "doctor"
      ],
      "expect": {
        "ok": true,
        "msIn": 2022,
        "msOut": 2024,
        "drIn": 2024,
        "drOut": 2027
      }
    },
    {
      "name": "補正: 浪人年数が小数はエラー",
      "func": "detailedYears",
      "args": [
        "1990-05-15",
        0.5,
        0,
        0,
        "none"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_years"
      }
    },
    {
      "name": "補正: 進学区分が不正はエラー",
      "func": "detailedYears",
      "args": [
        "1990-05-15",
        0,
        0,
        0,
        "phd"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_grad"
      }
    },
    {
      "name": "補正: 不正な日付はエラー",
      "func": "detailedYears",
      "args": [
        "1990-13-01",
        0,
        0,
        0,
        "none"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_date"
      }
    }
  ]
}
