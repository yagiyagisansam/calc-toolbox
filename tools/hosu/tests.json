{
  "tool": "hosu",
  "module": "calc.js",
  "global": "HosuCalc",
  "cases": [
    {
      "name": "1万歩・身長170cm・60kg: 歩幅76.5cm・7.65km・約115分・361kcal",
      "func": "calc",
      "args": [
        10000,
        170,
        60
      ],
      "expect": {
        "ok": true,
        "strideCm": 76.5,
        "distanceKm": 7.65,
        "timeMin": 115,
        "kcal": 361
      }
    },
    {
      "name": "体重なしでも距離と時間は計算できる",
      "func": "calc",
      "args": [
        8000,
        155
      ],
      "expect": {
        "ok": true,
        "strideCm": 69.8,
        "distanceKm": 5.58,
        "timeMin": 84
      }
    },
    {
      "name": "3,000歩・180cm・80kg: 2.43km・153kcal",
      "func": "calc",
      "args": [
        3000,
        180,
        80
      ],
      "expect": {
        "ok": true,
        "distanceKm": 2.43,
        "timeMin": 36,
        "kcal": 153
      }
    },
    {
      "name": "歩幅は身長×0.45(160cm→72cm)",
      "func": "calc",
      "args": [
        1000,
        160
      ],
      "expect": {
        "ok": true,
        "strideCm": 72,
        "distanceKm": 0.72
      }
    },
    {
      "name": "異常入力: 歩数0はエラー",
      "func": "calc",
      "args": [
        0,
        170
      ],
      "expect": {
        "ok": false,
        "code": "invalid_steps"
      }
    },
    {
      "name": "異常入力: 歩数20万超はエラー",
      "func": "calc",
      "args": [
        250000,
        170
      ],
      "expect": {
        "ok": false,
        "code": "invalid_steps"
      }
    },
    {
      "name": "異常入力: 身長100cm未満はエラー",
      "func": "calc",
      "args": [
        10000,
        90
      ],
      "expect": {
        "ok": false,
        "code": "invalid_height"
      }
    },
    {
      "name": "異常入力: 体重20kg未満はエラー",
      "func": "calc",
      "args": [
        10000,
        170,
        10
      ],
      "expect": {
        "ok": false,
        "code": "invalid_weight"
      }
    },
    {
      "name": "目標残り: 目標1万歩・現在6500歩・170cm/60kgは残り3500歩=2.68km/40分/127kcal",
      "func": "remainingToGoal",
      "args": [
        10000,
        6500,
        170,
        60
      ],
      "expect": {
        "ok": true,
        "remainingSteps": 3500,
        "achieved": false,
        "distanceKm": 2.68,
        "timeMin": 40,
        "kcal": 127
      }
    },
    {
      "name": "目標残り: 目標を超えていれば達成(残り0)",
      "func": "remainingToGoal",
      "args": [
        10000,
        12000,
        170,
        60
      ],
      "expect": {
        "ok": true,
        "remainingSteps": 0,
        "achieved": true,
        "distanceKm": 0,
        "timeMin": 0,
        "kcal": 0
      }
    },
    {
      "name": "目標残り: 体重なしでも距離と時間は出る(8000歩目標・3000歩・160cm)",
      "func": "remainingToGoal",
      "args": [
        8000,
        3000,
        160
      ],
      "expect": {
        "ok": true,
        "remainingSteps": 5000,
        "achieved": false,
        "distanceKm": 3.6,
        "timeMin": 54
      }
    },
    {
      "name": "目標残り: 現在の歩数0も計算できる(残り1万歩=7.65km)",
      "func": "remainingToGoal",
      "args": [
        10000,
        0,
        170
      ],
      "expect": {
        "ok": true,
        "remainingSteps": 10000,
        "distanceKm": 7.65,
        "timeMin": 115
      }
    },
    {
      "name": "目標残り: 目標0歩はエラー",
      "func": "remainingToGoal",
      "args": [
        0,
        100,
        170
      ],
      "expect": {
        "ok": false,
        "code": "invalid_goal"
      }
    },
    {
      "name": "目標残り: 現在の歩数が負はエラー",
      "func": "remainingToGoal",
      "args": [
        10000,
        -1,
        170
      ],
      "expect": {
        "ok": false,
        "code": "invalid_steps"
      }
    },
    {
      "name": "実測歩幅: 1万歩×歩幅70cm/60kgは7km/105分/331kcal",
      "func": "calcWithStride",
      "args": [
        10000,
        70,
        60
      ],
      "expect": {
        "ok": true,
        "distanceKm": 7,
        "timeMin": 105,
        "kcal": 331
      }
    },
    {
      "name": "実測歩幅: 体重なし(8000歩×65cm)は5.2km/78分",
      "func": "calcWithStride",
      "args": [
        8000,
        65
      ],
      "expect": {
        "ok": true,
        "distanceKm": 5.2,
        "timeMin": 78
      }
    },
    {
      "name": "実測歩幅: 歩幅10cmは範囲外エラー",
      "func": "calcWithStride",
      "args": [
        8000,
        10
      ],
      "expect": {
        "ok": false,
        "code": "invalid_stride"
      }
    }
  ]
}
