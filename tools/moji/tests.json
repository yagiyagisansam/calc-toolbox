{
  "tool": "moji",
  "module": "calc.js",
  "global": "MojiCalc",
  "cases": [
    {
      "name": "「あいう えお」+改行+「かき」: 8文字(スペース込み)・7文字(除く)・2行",
      "func": "count",
      "args": [
        "あいう えお\nかき"
      ],
      "expect": {
        "ok": true,
        "chars": 8,
        "charsNoSpace": 7,
        "lines": 2,
        "genkoyoshi": 1
      }
    },
    {
      "name": "空文字は0文字・0行",
      "func": "count",
      "args": [
        ""
      ],
      "expect": {
        "ok": true,
        "chars": 0,
        "charsNoSpace": 0,
        "lines": 0,
        "genkoyoshi": 0
      }
    },
    {
      "name": "絵文字はサロゲートペアでも1文字と数える",
      "func": "count",
      "args": [
        "🍣🍺"
      ],
      "expect": {
        "ok": true,
        "chars": 2,
        "charsNoSpace": 2
      }
    },
    {
      "name": "全角スペースも「スペース除く」で除外",
      "func": "count",
      "args": [
        "あ　い"
      ],
      "expect": {
        "ok": true,
        "chars": 3,
        "charsNoSpace": 2
      }
    },
    {
      "name": "英数字混在",
      "func": "count",
      "args": [
        "Hello 世界!"
      ],
      "expect": {
        "ok": true,
        "chars": 9,
        "charsNoSpace": 8,
        "lines": 1
      }
    },
    {
      "name": "改行のみは文字数0・2行",
      "func": "count",
      "args": [
        "\n"
      ],
      "expect": {
        "ok": true,
        "chars": 0,
        "lines": 2
      }
    },
    {
      "name": "401文字は原稿用紙2枚",
      "func": "count",
      "args": [
        "あああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああ"
      ],
      "expect": {
        "ok": true,
        "chars": 401,
        "genkoyoshi": 2
      }
    },
    {
      "name": "異常入力: 文字列以外はエラー",
      "func": "count",
      "args": [
        123
      ],
      "expect": {
        "ok": false,
        "code": "invalid_text"
      }
    },
    {
      "name": "HTML除去: <p>こんにちは</p> は本文5文字",
      "func": "countHtmlStripped",
      "args": [
        "<p>こんにちは</p>"
      ],
      "expect": {
        "ok": true,
        "chars": 5,
        "charsNoSpace": 5
      }
    },
    {
      "name": "HTML除去: script/styleの中身は本文に数えない",
      "func": "countHtmlStripped",
      "args": [
        "<style>p{color:red}</style><p>あい</p><script>alert(1)</script>"
      ],
      "expect": {
        "ok": true,
        "chars": 2
      }
    },
    {
      "name": "HTML除去: コメントとDOCTYPEは無視",
      "func": "countHtmlStripped",
      "args": [
        "<!DOCTYPE html><!-- メモ --><b>あ</b>"
      ],
      "expect": {
        "ok": true,
        "chars": 1
      }
    },
    {
      "name": "HTML除去: 実体参照(&amp;等)は1文字に戻して数える",
      "func": "countHtmlStripped",
      "args": [
        "A&amp;B&lt;C&gt;&#12354;"
      ],
      "expect": {
        "ok": true,
        "chars": 7
      }
    },
    {
      "name": "HTML除去: 文字列以外はエラー",
      "func": "countHtmlStripped",
      "args": [
        123
      ],
      "expect": {
        "ok": false,
        "code": "invalid_text"
      }
    },
    {
      "name": "目標字数: 8文字の文章は400字以内に収まる(残り392)",
      "func": "checkTarget",
      "args": [
        "あいう えお\nかき",
        400,
        "chars"
      ],
      "expect": {
        "ok": true,
        "count": 8,
        "remaining": 392,
        "over": 0,
        "within": true
      }
    },
    {
      "name": "目標字数: スペース除く7文字で目標5字なら2文字オーバー",
      "func": "checkTarget",
      "args": [
        "あいう えお\nかき",
        5,
        "noSpace"
      ],
      "expect": {
        "ok": true,
        "count": 7,
        "remaining": 0,
        "over": 2,
        "within": false
      }
    },
    {
      "name": "目標字数: 0や小数はエラー",
      "func": "checkTarget",
      "args": [
        "あ",
        0,
        "chars"
      ],
      "expect": {
        "ok": false,
        "code": "invalid_limit"
      }
    },
    {
      "name": "単語数: 英文5語を数える",
      "func": "wordCount",
      "args": [
        "This is a pen ."
      ],
      "expect": {
        "ok": true,
        "words": 4
      }
    },
    {
      "name": "単語数: 日本語のみは0語",
      "func": "wordCount",
      "args": [
        "これは日本語の文章です。"
      ],
      "expect": {
        "ok": true,
        "words": 0
      }
    }
  ]
}
