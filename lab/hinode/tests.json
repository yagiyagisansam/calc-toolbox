{
  "tool": "hinode",
  "module": "calc.js",
  "global": "HinodeCalc",
  "cases": [
    {
      "name": "検算(国立天文台): 東京2026年1月1日は日の出6:51・南中11:44・日の入り16:38",
      "func": "calculate",
      "args": [2026, 1, 1, 35.6581, 139.7414, 9],
      "expect": { "ok": true, "sunrise": "6:51", "solarNoon": "11:44", "sunset": "16:38", "polar": null }
    },
    {
      "name": "検算(国立天文台): 東京2026年2月1日は日の出6:41・南中11:55・日の入り17:08",
      "func": "calculate",
      "args": [2026, 2, 1, 35.6581, 139.7414, 9],
      "expect": { "ok": true, "sunrise": "6:41", "solarNoon": "11:55", "sunset": "17:08" }
    },
    {
      "name": "検算(国立天文台): 根室2026年1月1日は日の出6:50・南中11:21・日の入り15:52",
      "func": "calculate",
      "args": [2026, 1, 1, 43.3333, 145.5833, 9],
      "expect": { "ok": true, "sunrise": "6:50", "solarNoon": "11:21", "sunset": "15:52" }
    },
    {
      "name": "検算(NOAA配布スプレッドシート): 北緯40度・西経105度・UTC-7の2010年6月21日",
      "func": "calculate",
      "args": [2010, 6, 21, 40, -105, -7],
      "expect": { "ok": true, "sunrise": "4:31", "sunset": "19:32", "solarNoon": "12:02", "dayLengthMinutes": 900.9 }
    },
    {
      "name": "夏至の東京は昼が長い(2026年6月21日は14時間34分。国立天文台の値と1分以内で一致)",
      "func": "calculate",
      "args": [2026, 6, 21, 35.6581, 139.7414, 9],
      "expect": { "ok": true, "sunrise": "4:26", "sunset": "19:00", "solarNoon": "11:43", "dayLength": "14時間34分" }
    },
    {
      "name": "赤道上の春分は昼夜がほぼ同じ長さになる",
      "func": "calculate",
      "args": [2026, 3, 20, 0, 0, 0],
      "expect": { "ok": true, "polar": null, "dayLength": "12時間7分" }
    },
    {
      "name": "白夜: 北緯78度の6月21日は太陽が沈まない",
      "func": "calculate",
      "args": [2026, 6, 21, 78, 15, 1],
      "expect": { "ok": true, "polar": "midnight_sun", "sunrise": null, "sunset": null, "dayLengthMinutes": 1440 }
    },
    {
      "name": "極夜: 北緯78度の12月21日は太陽が昇らない",
      "func": "calculate",
      "args": [2026, 12, 21, 78, 15, 1],
      "expect": { "ok": true, "polar": "polar_night", "sunrise": null, "sunset": null, "dayLengthMinutes": 0 }
    },
    {
      "name": "南半球では季節が逆になる(シドニー2026年12月21日・夏時間UTC+11は日の出5:41・日の入り20:05)",
      "func": "calculate",
      "args": [2026, 12, 21, -33.8688, 151.2093, 11],
      "expect": { "ok": true, "sunrise": "5:41", "sunset": "20:05", "dayLength": "14時間24分" }
    },
    {
      "name": "ユリウス日: 2010年6月21日の世界時0時は2455368.5",
      "func": "julianDay",
      "args": [2010, 6, 21],
      "expect": 2455368.5
    },
    {
      "name": "ユリウス日: 2000年1月1日の世界時0時は2451544.5",
      "func": "julianDay",
      "args": [2000, 1, 1],
      "expect": 2451544.5
    },
    {
      "name": "2つの日を比べる: 東京の1月1日と2月1日では昼が39.2分長くなる",
      "func": "compare",
      "args": [2026, 1, 1, 2026, 2, 1, 35.6581, 139.7414, 9],
      "expect": { "ok": true, "dayLengthDiffMinutes": 39.2 }
    },
    {
      "name": "境界値: うるう年の2月29日も計算できる(東京2028年2月29日)",
      "func": "calculate",
      "args": [2028, 2, 29, 35.6581, 139.7414, 9],
      "expect": { "ok": true, "polar": null, "sunrise": "6:12", "sunset": "17:35" }
    },
    {
      "name": "境界値: 北極点(北緯90度)の夏至は太陽が沈まない",
      "func": "calculate",
      "args": [2026, 6, 21, 90, 0, 0],
      "expect": { "ok": true, "polar": "midnight_sun" }
    },
    {
      "name": "異常入力: 存在しない月(13月)はエラー",
      "func": "calculate",
      "args": [2026, 13, 1, 35, 139, 9],
      "expect": { "ok": false, "code": "invalid_date" }
    },
    {
      "name": "異常入力: 存在しない日(2026年2月30日)はエラー",
      "func": "calculate",
      "args": [2026, 2, 30, 35, 139, 9],
      "expect": { "ok": false, "code": "invalid_date" }
    },
    {
      "name": "異常入力: 緯度が範囲外(95度)はエラー",
      "func": "calculate",
      "args": [2026, 1, 1, 95, 139, 9],
      "expect": { "ok": false, "code": "invalid_latitude" }
    },
    {
      "name": "異常入力: 経度が範囲外(200度)はエラー",
      "func": "calculate",
      "args": [2026, 1, 1, 35, 200, 9],
      "expect": { "ok": false, "code": "invalid_longitude" }
    },
    {
      "name": "異常入力: 時差が範囲外(20時間)はエラー",
      "func": "calculate",
      "args": [2026, 1, 1, 35, 139, 20],
      "expect": { "ok": false, "code": "invalid_timezone" }
    },
    {
      "name": "異常入力: 緯度が数値でないときはエラー",
      "func": "calculate",
      "args": [2026, 1, 1, "abc", 139, 9],
      "expect": { "ok": false, "code": "invalid_latitude" }
    },
    {
      "name": "異常入力: 引数なしはエラー",
      "func": "calculate",
      "args": [],
      "expect": { "ok": false, "code": "invalid_date" }
    },
    {
      "name": "異常入力: 年が範囲外(1500年)はエラー",
      "func": "calculate",
      "args": [1500, 1, 1, 35, 139, 9],
      "expect": { "ok": false, "code": "invalid_date" }
    }
  ]
}
