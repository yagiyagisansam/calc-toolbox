{
  "tool": "jisa",
  "module": "calc.js",
  "global": "JisaCalc",
  "cases": [
    {
      "name": "東京7月29日12:00 → ニューヨークは前日23:00(夏時間中でUTC-4)",
      "func": "convert",
      "args": ["Asia/Tokyo", "America/New_York", 2026, 7, 29, 12, 0],
      "expect": { "ok": true, "to": { "text": "2026-07-28 23:00", "offsetText": "-04:00", "isDst": true }, "diffMinutes": -780, "dayShift": -1 }
    },
    {
      "name": "東京1月15日12:00 → ニューヨークは前日22:00(標準時でUTC-5。夏時間との1時間差)",
      "func": "convert",
      "args": ["Asia/Tokyo", "America/New_York", 2026, 1, 15, 12, 0],
      "expect": { "ok": true, "to": { "text": "2026-01-14 22:00", "offsetText": "-05:00", "isDst": false }, "diffMinutes": -840 }
    },
    {
      "name": "東京7月29日12:00 → ロンドンは同日04:00(英国夏時間でUTC+1)",
      "func": "convert",
      "args": ["Asia/Tokyo", "America/New_York", 2026, 7, 29, 12, 0],
      "expect": { "ok": true, "from": { "text": "2026-07-29 12:00", "offsetText": "+09:00", "isDst": false } }
    },
    {
      "name": "東京7月29日12:00 → ロンドンは同日04:00",
      "func": "convert",
      "args": ["Asia/Tokyo", "Europe/London", 2026, 7, 29, 12, 0],
      "expect": { "ok": true, "to": { "text": "2026-07-29 04:00", "offsetText": "+01:00", "isDst": true }, "diffMinutes": -480, "dayShift": 0 }
    },
    {
      "name": "東京7月29日12:00 → シドニーは同日13:00(南半球なので7月は標準時)",
      "func": "convert",
      "args": ["Asia/Tokyo", "Australia/Sydney", 2026, 7, 29, 12, 0],
      "expect": { "ok": true, "to": { "text": "2026-07-29 13:00", "offsetText": "+10:00", "isDst": false }, "diffMinutes": 60 }
    },
    {
      "name": "30分刻みの時差: 東京12:00 → インド(コルカタ)は08:30",
      "func": "convert",
      "args": ["Asia/Tokyo", "Asia/Kolkata", 2026, 7, 29, 12, 0],
      "expect": { "ok": true, "to": { "text": "2026-07-29 08:30", "offsetText": "+05:30" }, "diffMinutes": -210 }
    },
    {
      "name": "東京12:00 → UTCは03:00(日本標準時はUTC+9)",
      "func": "convert",
      "args": ["Asia/Tokyo", "UTC", 2026, 7, 29, 12, 0],
      "expect": { "ok": true, "to": { "text": "2026-07-29 03:00", "offsetText": "+00:00" }, "diffMinutes": -540 }
    },
    {
      "name": "逆方向も一致: ニューヨーク7月28日23:00 → 東京は翌日12:00",
      "func": "convert",
      "args": ["America/New_York", "Asia/Tokyo", 2026, 7, 28, 23, 0],
      "expect": { "ok": true, "to": { "text": "2026-07-29 12:00" }, "diffMinutes": 780, "dayShift": 1 }
    },
    {
      "name": "UTC+14のキリバス(クリスマス島): 東京12:00は同日17:00",
      "func": "convert",
      "args": ["Asia/Tokyo", "Pacific/Kiritimati", 2026, 7, 29, 12, 0],
      "expect": { "ok": true, "to": { "text": "2026-07-29 17:00", "offsetText": "+14:00" }, "diffMinutes": 300 }
    },
    {
      "name": "サマータイム開始で存在しない時刻(NY 2026年3月8日02:30)はskippedになる",
      "func": "convert",
      "args": ["America/New_York", "Asia/Tokyo", 2026, 3, 8, 2, 30],
      "expect": { "ok": true, "skipped": true, "ambiguous": false }
    },
    {
      "name": "サマータイム終了で2回ある時刻(NY 2026年11月1日01:30)はambiguousになる",
      "func": "convert",
      "args": ["America/New_York", "Asia/Tokyo", 2026, 11, 1, 1, 30],
      "expect": { "ok": true, "skipped": false, "ambiguous": true }
    },
    {
      "name": "切替直後の時刻(NY 2026年11月1日03:30)は標準時UTC-5で普通に換算される",
      "func": "convert",
      "args": ["America/New_York", "Asia/Tokyo", 2026, 11, 1, 3, 30],
      "expect": { "ok": true, "skipped": false, "ambiguous": false, "diffMinutes": 840 }
    },
    {
      "name": "オフセット: 日本標準時は540分(UTC+9)",
      "func": "offsetMinutes",
      "args": ["Asia/Tokyo", 0],
      "expect": { "ok": true, "offsetMinutes": 540 }
    },
    {
      "name": "オフセット: インド標準時は330分(UTC+5:30)",
      "func": "offsetMinutes",
      "args": ["Asia/Kolkata", 0],
      "expect": { "ok": true, "offsetMinutes": 330 }
    },
    {
      "name": "分解: UTC 0ミリ秒は東京では1970年1月1日09:00",
      "func": "describe",
      "args": ["Asia/Tokyo", 0],
      "expect": { "ok": true, "text": "1970-01-01 09:00", "offsetText": "+09:00", "isDst": false }
    },
    {
      "name": "境界値: 年の下限1900年も扱える",
      "func": "toTimestamp",
      "args": ["UTC", 1900, 1, 1, 0, 0],
      "expect": { "ok": true, "timestamp": -2208988800000 }
    },
    {
      "name": "異常入力: 存在しないタイムゾーン(基準側)はエラー",
      "func": "convert",
      "args": ["Bad/Zone", "Asia/Tokyo", 2026, 7, 29, 12, 0],
      "expect": { "ok": false, "code": "invalid_from_zone" }
    },
    {
      "name": "異常入力: 存在しないタイムゾーン(相手側)はエラー",
      "func": "convert",
      "args": ["Asia/Tokyo", "Bad/Zone", 2026, 7, 29, 12, 0],
      "expect": { "ok": false, "code": "invalid_to_zone" }
    },
    {
      "name": "異常入力: 存在しない日付(2026年2月30日)はエラー",
      "func": "convert",
      "args": ["Asia/Tokyo", "UTC", 2026, 2, 30, 12, 0],
      "expect": { "ok": false, "code": "invalid_datetime" }
    },
    {
      "name": "異常入力: 13月はエラー",
      "func": "convert",
      "args": ["Asia/Tokyo", "UTC", 2026, 13, 1, 12, 0],
      "expect": { "ok": false, "code": "invalid_datetime" }
    },
    {
      "name": "異常入力: 25時はエラー",
      "func": "convert",
      "args": ["Asia/Tokyo", "UTC", 2026, 7, 29, 25, 0],
      "expect": { "ok": false, "code": "invalid_datetime" }
    },
    {
      "name": "異常入力: 60分はエラー",
      "func": "convert",
      "args": ["Asia/Tokyo", "UTC", 2026, 7, 29, 12, 60],
      "expect": { "ok": false, "code": "invalid_datetime" }
    },
    {
      "name": "異常入力: 年が下限1900年より前はエラー",
      "func": "toTimestamp",
      "args": ["Asia/Tokyo", 1899, 1, 1, 0, 0],
      "expect": { "ok": false, "code": "invalid_datetime" }
    },
    {
      "name": "異常入力: タイムスタンプが数値でないときはエラー",
      "func": "offsetMinutes",
      "args": ["Asia/Tokyo", "abc"],
      "expect": { "ok": false, "code": "invalid_timestamp" }
    },
    {
      "name": "異常入力: 引数なしはエラー",
      "func": "convert",
      "args": [],
      "expect": { "ok": false, "code": "invalid_from_zone" }
    }
  ]
}
